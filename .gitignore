# 依赖
node_modules/

# 构建产物
dist/
.astro/

# 系统文件
.DS_Store
Thumbs.db

# 日志
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# 环境变量（放密钥的话不要提交）
.env
.env.production

# Cloudflare Worker 本地缓存（wrangler deploy 时生成）
.wrangler/

# 临时文件：截图、草稿图片等，不该进仓库
uploads/

# Playwright 调试产物（截图 / a11y 快照 / 控制台日志）
.playwright-mcp/

# 照片墙的演示占位图（scripts/gen-placeholders.mjs 在本地生成，不进仓库）
# 真实照片走图床（R2 gallery/），config/gallery.json 里只存 URL。
# 如果确实想把本地图片提交进仓库，把下面这行删掉即可。
public/image/gallery/
