---
/**
 * 站点配置 · 字段行
 * ------------------------------------------------------------
 * 排布方式由 type 自动决定，调用方不用关心：
 *   inline —— text / number / select / toggle / range：
 *             label 左（固定 180px）、控件右，于是所有 label 左边缘、
 *             所有控件左边缘各自成一条竖线。这是「视觉对齐」的关键。
 *   block  —— textarea / lines，或显式 wide：
 *             label 上、控件下通栏（多行文本撑不满一行会很难看）。
 *
 * 数据通路（config.ts 依赖，**改版时不要动这些属性名**）：
 *   data-cfg        文本 / 下拉，值是 config 里的点路径（如 site.title）
 *   data-cfg-number 数字 / 滑杆
 *   data-cfg-check  开关
 *   data-cfg-lines  按行拆成字符串数组的多行文本
 *   滑杆必须包在 `.config-range` 里（config.ts 用 closest 找），
 *   数值节点带 data-cfg-range-output。
 *
 * 说明文字去哪了：改版后 hint 不再渲染。字段含义看这里和
 * docs/config-fields.md；格式示例放 placeholder，界面上别写长句。
 *
 * @param path        config 点路径
 * @param label       行标签，界面上唯一可见的说明，务必短（一行放不下会省略号）
 * @param type        控件类型
 * @param value       当前值
 * @param placeholder 示例值放这里，替代以前的 hint
 * @param unit        数字 / 滑杆后面的单位
 * @param options     select 的选项
 * @param rows        textarea / lines 的初始行数
 * @param wide        强制上下布局
 * @param hint        @deprecated 不再渲染
 */
interface Props {
  /** config 里的路径，如 site.title、site.banner.interval */
  path: string;
  label: string;
  hint?: string;
  type?: 'text' | 'number' | 'range' | 'textarea' | 'lines' | 'select' | 'toggle';
  value?: string | number | boolean | string[];
  placeholder?: string;
  unit?: string;
  options?: { value: string; label: string }[];
  rows?: number;
  /** 窄屏也占满整行 */
  wide?: boolean;
  min?: number;
  max?: number;
  step?: number;
}

const {
  path,
  label,
  type = 'text',
  value = '',
  placeholder,
  unit,
  options = [],
  rows = 6,
  wide = false,
  min,
  max,
  step,
} = Astro.props;

const current = Array.isArray(value) ? value.join('\n') : value;

/** 单行控件走左右排布，其余一律上下通栏 */
const INLINE_TYPES = new Set(['text', 'number', 'select', 'toggle', 'range']);
const isBlock = wide || !INLINE_TYPES.has(type);
---

<label class:list={['cfg-row', isBlock && 'cfg-row--block']}>
  <span class="cfg-row__label" title={label}>{label}</span>

  <span class="cfg-row__ctrl">
    {
      type === 'textarea' && (
        <textarea
          class="input-pill"
          rows={rows}
          spellcheck="false"
          data-cfg={path}
          placeholder={placeholder}>{String(current)}</textarea>
      )
    }

    {
      type === 'lines' && (
        <textarea
          class="input-pill"
          rows={rows}
          spellcheck="false"
          data-cfg-lines={path}
          placeholder={placeholder}>{String(current)}</textarea>
      )
    }

    {
      type === 'select' && (
        <select class="input-pill" data-cfg={path}>
          {options.map((option) => (
            <option value={option.value} selected={String(current) === option.value}>
              {option.label}
            </option>
          ))}
        </select>
      )
    }

    {
      type === 'number' && (
        <span class="flex items-center gap-2">
          <input
            class="input-pill"
            type="number"
            data-cfg-number={path}
            value={current}
            placeholder={placeholder}
            min={min}
            max={max}
            step={step}
          />
          {unit && <span class="cfg-unit">{unit}</span>}
        </span>
      )
    }

    {
      type === 'toggle' && (
        <span class="cfg-toggle-wrap">
          <input
            type="checkbox"
            class="toggle toggle-primary toggle-sm"
            data-cfg-check={path}
            checked={Boolean(value)}
          />
        </span>
      )
    }

    {
      type === 'range' && (
        <span class="config-range">
          <input
            type="range"
            class="config-range__input"
            data-cfg-number={path}
            data-cfg-range
            value={String(value)}
            min={min ?? 0}
            max={max ?? 100}
            step={step ?? 1}
          />
          <output class="config-range__value" data-cfg-range-output>
            {String(value)}
          </output>
          {unit && <span class="cfg-unit">{unit}</span>}
        </span>
      )
    }

    {
      type === 'text' && (
        <input class="input-pill" data-cfg={path} value={String(current)} placeholder={placeholder} />
      )
    }
  </span>
</label>
