---
/**
 * 移动导航（<1024px 显示）
 * ------------------------------------------------------------
 * 品牌图 + 图标按钮组；菜单收进「汉堡」下拉面板，
 * 面板里放主菜单 + 页面设置（配色、Banner 模式、明暗）。
 */
import { Icon } from 'astro-icon/components';
import { SITE, SITE_MENU } from '../../site.config';
import AuthChip from '../AuthChip.astro';
import ThemeToggle from '../theme/ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

/** 写作入口（仅站长可见）：和桌面版一样跟在「文章」后面 */
const menuItems = SITE_MENU.map((item) => ({ ...item, adminOnly: false }));
const blogIndex = menuItems.findIndex((item) => item.id === 'blog');
menuItems.splice(
  blogIndex === -1 ? menuItems.length : blogIndex + 1,
  0,
  {
    id: 'write',
    text: '写作',
    href: '/write/',
    icon: 'material-symbols:edit-note-rounded',
    adminOnly: true,
  },
);
---

<div class="flex w-full items-center gap-2 lg:hidden">
  <a href="/" class="brand brand--compact" aria-label={`${SITE.title} 首页`}>
    {
      SITE.titleType === 'image' ? (
        <img
          src={SITE.titleImage}
          alt={SITE.title}
          width="194"
          height="104"
          decoding="async"
          class="brand__logo"
        />
      ) : (
        <span class="brand__text max-w-[9rem] truncate">{SITE.title}</span>
      )
    }
  </a>

  <div class="ml-auto flex items-center gap-1.5">
    <!-- 登录入口摆在最外面（不进汉堡面板），和桌面版一致 -->
    <AuthChip />
    <ThemeToggle />

    <!-- 汉堡菜单 -->
    <div class="relative" data-dropdown>
      <button
        type="button"
        class="btn-round"
        data-dropdown-toggle
        aria-haspopup="true"
        aria-expanded="false"
        aria-label="菜单"
        title="菜单"
      >
        <Icon name="material-symbols:menu-rounded" class="h-5 w-5" />
      </button>

      <div class="dropdown-panel dropdown-panel--sm" data-dropdown-menu hidden>
        <nav class="flex flex-col gap-0.5">
          {
            menuItems.map((item) => (
              <a
                class="nav-link justify-start"
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                data-admin-link={item.adminOnly ? '' : undefined}
                hidden={item.adminOnly || undefined}
              >
                <Icon name={item.icon} class="h-5 w-5" />
                <span>{item.text}</span>
              </a>
            ))
          }
        </nav>

        <div class="mt-2 border-t border-base-content/10 pt-2">
          <a class="nav-link justify-start" href="/archive/">
            <Icon name="material-symbols:calendar-month-outline" class="h-5 w-5" />
            <span>归档</span>
          </a>
          <a class="nav-link justify-start" href="/search/">
            <Icon name="material-symbols:search-rounded" class="h-5 w-5" />
            <span>搜索</span>
          </a>
          <a class="nav-link justify-start" href="/about/">
            <Icon name="material-symbols:person-outline" class="h-5 w-5" />
            <span>关于</span>
          </a>
          <a data-admin-link hidden class="nav-link justify-start" href="/config/">
            <Icon name="material-symbols:settings-outline" class="h-5 w-5" />
            <span>站点配置</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import '../../scripts/theme';
</script>
