---
import FormattedDate from './FormattedDate.astro';

interface Props {
  href: string;
  title: string;
  description?: string;
  date: Date;
  tags?: string[];
}

const { href, title, description, date, tags = [] } = Astro.props;
---

<li class="post-card">
  <div class="post-card__meta">
    <FormattedDate date={date} />
    {
      tags.slice(0, 3).map((tag) => (
        <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>
          #{tag}
        </a>
      ))
    }
  </div>
  <h3 class="post-card__title">
    <a href={href}>{title}</a>
  </h3>
  {description && <p class="post-card__desc">{description}</p>}
</li>
