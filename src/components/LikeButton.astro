---
/**
 * 文章页的点赞按钮
 * ------------------------------------------------------------
 * 规则：必须用 GitHub 登录后每篇只能点一次，可再次点击取消。
 * 数字和「我点过没有」都来自 Worker（/api/meta、/api/like），存在 KV 里。
 * 样式是行内的图标 + 数字；调用逻辑与之前完全一致。
 */
import { Icon } from 'astro-icon/components';

interface Props {
  /** 文章路径，如 /posts/hello-world/ */
  path: string;
}

const { path } = Astro.props;
---

<span class="inline-flex items-center gap-1" data-like-wrap data-path={path} data-pagefind-ignore>
  <button
    type="button"
    class="like-inline inline-flex items-center gap-1 text-xs text-base-content/55"
    data-like-btn
    aria-pressed="false"
    aria-label="点赞这篇文章"
    title="用 GitHub 账号登录后点赞"
  >
    <Icon name="material-symbols:favorite-outline" class="like-heart h-4 w-4" />
    <span data-like-count>—</span>
    <span class="sr-only" data-like-label>点赞</span>
  </button>
  <span class="hidden rounded-full bg-primary/10 px-1.5 py-0.5 text-[0.625rem] text-primary" data-like-hint>
    已赞
  </span>
</span>

<script>
  import { ApiError, clearSession, fetchMeta, getSession, onAuthChange, openLogin, sendLike, showToast } from '../utils/site';
  import { onPageLoad } from '../scripts/pageload';

  function initLike(): void {
    const wrap = document.querySelector<HTMLElement>('[data-like-wrap]');
    if (!wrap) return;
    // 换页后 DOM 是新元素；同一元素不重复绑定
    if (wrap.dataset.init === '1') return;

    const path = wrap.dataset.path || location.pathname;
    const btn = wrap.querySelector<HTMLButtonElement>('[data-like-btn]');
    const countEl = wrap.querySelector<HTMLElement>('[data-like-count]');
    const labelEl = wrap.querySelector<HTMLElement>('[data-like-label]');
    const hintEl = wrap.querySelector<HTMLElement>('[data-like-hint]');

    if (btn && countEl && labelEl && hintEl) {
      wrap.dataset.init = '1';

      let busy = false;
      let liked = false;

      const render = (count: number, nextLiked: boolean) => {
        liked = nextLiked;
        countEl.textContent = count.toLocaleString('zh-CN');
        btn.setAttribute('aria-pressed', String(nextLiked));
        btn.setAttribute('aria-label', nextLiked ? '取消点赞' : '点赞这篇文章');
        labelEl.textContent = nextLiked ? '已赞' : '点赞';
        hintEl.classList.toggle('hidden', !nextLiked);
      };

      const refresh = async () => {
        // 换页后旧节点已从文档里移除，别再给它更新
        if (!wrap.isConnected) return;
        try {
          const map = await fetchMeta([path]);
          const item = map[path];
          if (item) render(item.likes, item.liked);
          else render(0, false);
        } catch {
          /* 服务不可用时保留占位「—」，不打扰阅读 */
        }
      };

      btn.addEventListener('click', async () => {
        if (busy) return;
        busy = true;
        btn.disabled = true;
        try {
          if (!getSession()) {
            try {
              await openLogin();
            } catch (error) {
              showToast(error instanceof Error ? error.message : '登录失败，请重试');
              return;
            }
          }

          // 登录后先取一次真实状态，避免重复点赞
          const current = getSession() ? await fetchMeta([path]) : {};
          const item = current[path];
          const shouldUnlike = item ? item.liked : liked;

          const result = await sendLike(path, shouldUnlike ? 'unlike' : 'like');
          render(result.count, result.liked);
          if (shouldUnlike) showToast('已取消点赞');
        } catch (error) {
          if (error instanceof ApiError && error.status === 401) {
            clearSession();
            showToast('登录已过期，请重新登录');
          } else {
            showToast(error instanceof Error ? error.message : '操作失败，请稍后再试');
          }
        } finally {
          busy = false;
          btn.disabled = false;
        }
      });

      onAuthChange(refresh);
      refresh();
    }
  }

  onPageLoad(initLike);
</script>
