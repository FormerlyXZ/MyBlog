---
/**
 * 页脚（卡片式）
 * ------------------------------------------------------------
 * 内容全部来自 config/site.json → footer：
 *   版权 / Powered by / 社交图标 / 备案号（留空则不显示，D12）
 *
 * 站长入口（写文章、站点配置、统计）默认 hidden，
 * 由 BaseLayout 里的脚本判断登录状态后显示。
 */
import { Icon } from 'astro-icon/components';
import { FOOTER, SITE, USER } from '../site.config';

const year = new Date().getFullYear();
const copyright = FOOTER.copyright.includes('{year}')
  ? FOOTER.copyright.replace('{year}', String(year))
  : `${FOOTER.copyright}`;
---

<footer class="site-footer-new">
  <div class="card-neu card-neu--flat flex flex-col gap-4 p-6 sm:flex-row sm:items-center">
    <!-- 左：版权与声明 -->
    <div class="min-w-0 flex-1">
      <p class="text-sm font-medium">
        {copyright || `© ${year} ${USER.name}`}
      </p>
      <p class="mt-1 text-xs leading-relaxed text-base-content/50">
        {FOOTER.poweredBy}
      </p>
    </div>

    <!-- 中：站长入口（访客不可见） -->
    <div class="flex flex-wrap items-center gap-2">
      <a data-admin-link hidden href="/write/" class="btn-pill text-xs">
        <Icon name="material-symbols:edit-outline" class="h-4 w-4" />
        <span>写文章</span>
      </a>
      <a data-admin-link hidden href="/config/" class="btn-pill text-xs">
        <Icon name="material-symbols:settings-outline" class="h-4 w-4" />
        <span>站点配置</span>
      </a>
      <a data-admin-link hidden href="/stats/" class="btn-pill text-xs">
        <Icon name="material-symbols:bar-chart-outline" class="h-4 w-4" />
        <span>统计</span>
      </a>
    </div>

    <!-- 右：社交 -->
    <div class="flex items-center gap-1.5">
      {
        FOOTER.social.map((item) => (
          <a
            href={item.href}
            class="btn-round"
            target="_blank"
            rel="me noopener noreferrer"
            title={item.label}
            aria-label={item.label}
          >
            <Icon name={item.icon} class="h-[1.15rem] w-[1.15rem]" />
          </a>
        ))
      }
    </div>
  </div>

  <!-- 最底部：站点名 + 两种备案号（各自留空则自动省略） -->
  <div
    class="footer-meta mt-4 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-center text-[0.6875rem] leading-relaxed text-base-content/45"
  >
    <span>{SITE.title}</span>
    {
      FOOTER.icp && (
        <span class="inline-flex items-center gap-x-2">
          <span aria-hidden="true" class="opacity-40">·</span>
          <a
            href={FOOTER.icpLink || 'https://beian.miit.gov.cn/'}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors hover:text-primary"
            title="工业和信息化部ICP/IP地址/域名信息备案管理系统"
          >
            {FOOTER.icp}
          </a>
        </span>
      )
    }
    {
      FOOTER.mps && (
        <span class="inline-flex items-center gap-x-2">
          <span aria-hidden="true" class="opacity-40">·</span>
          <a
            href={FOOTER.mpsLink || 'https://beian.mps.gov.cn/#/query/webSearch'}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 transition-colors hover:text-primary"
            title="全国互联网安全管理服务平台"
          >
            {FOOTER.mpsLogo && (
              <img
                src={FOOTER.mpsLogo}
                alt=""
                aria-hidden="true"
                width="15"
                height="16"
                loading="lazy"
                decoding="async"
                class="h-4 w-auto shrink-0"
              />
            )}
            <span>{FOOTER.mps}</span>
          </a>
        </span>
      )
    }
  </div>
</footer>
