---
/**
 * LoadingTide —— 远航（潮汐加载）
 * ============================================================
 * 整屏的海天场景，用作换页/慢加载时的「过渡遮罩」：
 *
 *   涨潮(海天铺满整屏) → 航行(船 x = 真实进度) → 靠岸(太阳涨满) → 退潮
 *
 * 视觉（全部由主题变量驱动，29 套主题自动换色）：
 *   · 大字：像素 LOADING（7×9 字符网格），字面吃主题的 --bc，
 *         船开到哪个字母脚下就点亮哪个 —— 它本身就是第二根进度条
 *   · 天空：base-2 的渐变 + 水平线附近的晨昏光 + 星屑
 *   · 太阳：主题色光晕 + 暖白核心，随进度胀大（“驶向光”）
 *   · 海：三层正弦浪。浪是 <canvas> 画的 —— 每帧重绘的是一块 GPU 画布，
 *         比让浏览器每帧重排/重绘整块 SVG（含描边）便宜得多，这才撑得住 60fps
 *   · 船：48×34 格的像素帆船，白帆 + 墨色描边（描边逐格自动生成），
 *         主题色做旗与舷窗。船是 DOM 元素，每帧只写 transform（合成层），不触发重排
 *   · 船在浪上：位置 = 进度，高度 = 脚下浪面高度，俯仰 = 浪面斜率（带阻尼，
 *     船比浪慢半拍才像一艘大船，而不是贴图）
 *
 * 性能要点（改之前先读）：
 *   · 船和太阳都**不用 filter / box-shadow**：滤镜会让元素每帧重新栅格化，
 *     这曾经是卡顿的主因。船底阴影是一个静态的径向渐变椭圆
 *   · 海面升降用 transform 平移整块海，不改变高度 —— 不引发重排
 *   · 天空/太阳的明暗只写 opacity，海水升降只写 transform，全部走合成层
 *
 * 显示逻辑（每次换页都播、超时兜底）在 scripts/loader.ts。
 * 带 transition:persist：换页时这片海不会被替换，船和浪的状态能跨页延续。
 *
 * ?tide=4200 在地址栏可自动演示一遍；控制台 __tideDemo(4200) 随时重播。
 */
type Cell = '.' | '#' | 'o' | '*' | 'w';

const COLS = 48;
const ROWS = 34;
const UNIT = 2; // 每个像素格 = 2 用户单位

/* ---------------- 像素帆船：在网格上逐格画出来 ---------------- */

const SHIP_GRID: Cell[][] = Array.from({ length: ROWS }, () => Array<Cell>(COLS).fill('.'));

function fill(x: number, y: number, w: number, h: number, c: Cell): void {
  for (let j = y; j < y + h; j++) {
    for (let i = x; i < x + w; i++) {
      if (j >= 0 && j < ROWS && i >= 0 && i < COLS) SHIP_GRID[j][i] = c;
    }
  }
}

// ---- 帆（先画，桅杆随后压在帆上）----
// 主帆：上桅帆（小）+ 主帆（大），中间留一道缝，帆型才分得开
fill(17, 4, 8, 1, 'o');
fill(16, 5, 10, 3, 'o');
fill(19, 8, 4, 1, 'o');
fill(16, 10, 8, 1, 'o');
fill(14, 11, 12, 1, 'o');
fill(13, 12, 16, 13, 'o');
fill(15, 25, 12, 1, 'o');
fill(18, 26, 6, 1, 'o');
// 前帆：上桅帆 + 主帆
fill(31, 9, 5, 1, 'o');
fill(30, 10, 7, 2, 'o');
fill(30, 13, 8, 1, 'o');
fill(28, 14, 11, 11, 'o');
fill(30, 25, 7, 1, 'o');
// 后帆（斜桁帆）
fill(5, 18, 8, 1, 'o');
fill(4, 19, 10, 6, 'o');
fill(6, 25, 6, 1, 'o');
// 船首小三角帆（斜桁下面）
fill(41, 22, 4, 1, 'o');
fill(40, 23, 5, 1, 'o');
fill(40, 24, 6, 1, 'o');
fill(41, 25, 5, 1, 'o');

// ---- 桅杆与桁条（一根一格，细了才不糊）----
fill(20, 3, 1, 25, '#'); // 主桅
fill(32, 7, 1, 21, '#'); // 前桅
fill(10, 16, 1, 12, '#'); // 后桅
fill(16, 9, 8, 1, '#'); // 主桅上横桁
fill(30, 12, 8, 1, '#'); // 前桅上横桁
fill(17, 26, 7, 1, '#'); // 主桅下横桁

// ---- 船身与尾楼 ----
fill(13, 27, 29, 1, 'w'); // 甲板沿（受光的一线）
fill(12, 28, 31, 2, '#');
fill(14, 30, 27, 1, '#');
fill(17, 31, 21, 1, '#');
fill(20, 32, 15, 1, '#');
fill(24, 33, 7, 1, '#'); // 龙骨
fill(4, 22, 8, 1, 'w'); // 尾楼甲板
fill(3, 23, 10, 5, '#'); // 尾楼
fill(2, 24, 11, 1, '#'); // 尾楼围栏
fill(42, 26, 2, 2, '#'); // 船首上扬
// 斜桁（船首出的一根杆）
fill(44, 24, 1, 2, '#');
fill(45, 22, 1, 2, '#');
fill(46, 20, 1, 2, '#');

// ---- 旗与舷窗（主题色）----
fill(21, 3, 4, 1, '*');
fill(21, 4, 3, 1, '*');
fill(33, 7, 3, 1, '*');
fill(33, 8, 2, 1, '*');
fill(16, 30, 1, 1, '*');
fill(21, 30, 1, 1, '*');
fill(26, 30, 1, 1, '*');
fill(31, 30, 1, 1, '*');
fill(5, 25, 1, 1, '*'); // 尾楼窗
fill(8, 25, 1, 1, '*');
fill(11, 25, 1, 1, '*');

/** 描边：所有紧挨着图形的空格，补一格墨色（像素精灵的经典画法） */
const OUTLINED: Cell[][] = (() => {
  const next = SHIP_GRID.map((row) => row.slice());
  for (let y = 0; y < ROWS; y++) {
    for (let x = 0; x < COLS; x++) {
      if (SHIP_GRID[y][x] !== '.') continue;
      const near =
        (SHIP_GRID[y - 1]?.[x] !== undefined && SHIP_GRID[y - 1][x] !== '.') ||
        (SHIP_GRID[y + 1]?.[x] !== undefined && SHIP_GRID[y + 1][x] !== '.') ||
        (SHIP_GRID[y][x - 1] !== undefined && SHIP_GRID[y][x - 1] !== '.') ||
        (SHIP_GRID[y][x + 1] !== undefined && SHIP_GRID[y][x + 1] !== '.');
      if (near) next[y][x] = '#';
    }
  }
  return next;
})();

/** 网格 → 逐行合并的矩形（同样的颜色连在一起就并成一条） */
const SHIP_RECTS: { x: number; y: number; w: number; cls: string }[] = (() => {
  const clsOf: Record<string, string> = {
    '#': 'tide-px__ink',
    o: 'tide-px__face',
    '*': 'tide-px__accent',
    w: 'tide-px__light',
  };
  const out: { x: number; y: number; w: number; cls: string }[] = [];
  for (let y = 0; y < ROWS; y++) {
    let x = 0;
    while (x < COLS) {
      const c = OUTLINED[y][x];
      if (c === '.') {
        x++;
        continue;
      }
      let w = 1;
      while (x + w < COLS && OUTLINED[y][x + w] === c) w++;
      out.push({ x: x * UNIT, y: y * UNIT, w: w * UNIT, cls: clsOf[c] });
      x += w;
    }
  }
  return out;
})();

/* ---------------- 海：三层正弦浪（参数交给 loader.ts 用 canvas 画） ---------------- */

// 远 → 近：越近的浪越低、越实、漂得越快（视差）。波长给大，是开阔海面的长涌
// 注意：这里的 len/amp 是「百分比」，实际像素由 loader.ts 的 computeMetrics() 换算 ——
//   手机窄屏上直接按百分比铺会把波长压成小尖峰，所以那边给波长设了像素下限。
const SEA = [
  { baseY: 10, amp: 4, len: 32, speed: 3, opacity: 0.55 },
  { baseY: 16, amp: 8, len: 26, speed: 5, opacity: 0.75 },
  { baseY: 24, amp: 12, len: 20, speed: 8, opacity: 1 },
];

const SEA_DATA = JSON.stringify({ bands: SEA });

/* ---------------- 像素大字：LOADING ----------------
 * 和船同一套画法：字符网格 → 逐行合并矩形（但不描边，原因见 glyphRects）。
 *
 * 它是**第二根进度条**：scripts/loader.ts 拿船的中线 x 去比每个字母的中心，
 * 船开到哪个字母脚下，那个字母就点亮 —— 判据和船、百分比是同一个数。
 * 'o' = 字面的格子
 */
const GW = 7; // 字宽（格）
const GH = 9; // 字高（格）
const GAP = 1; // 字间距（格）
const WORD_TEXT = 'LOADING';

const GLYPHS: Record<string, string[]> = {
  L: ['oo.....', 'oo.....', 'oo.....', 'oo.....', 'oo.....', 'oo.....', 'oo.....', 'oooooo.', 'oooooo.'],
  O: ['.ooooo.', 'oo...oo', 'oo...oo', 'oo...oo', 'oo...oo', 'oo...oo', 'oo...oo', 'oo...oo', '.ooooo.'],
  A: ['..ooo..', '.ooooo.', 'oo...oo', 'oo...oo', 'ooooooo', 'oo...oo', 'oo...oo', 'oo...oo', 'oo...oo'],
  D: ['oooooo.', 'oo...oo', 'oo...oo', 'oo...oo', 'oo...oo', 'oo...oo', 'oo...oo', 'oo...oo', 'oooooo.'],
  I: ['ooooooo', 'ooooooo', '..ooo..', '..ooo..', '..ooo..', '..ooo..', '..ooo..', 'ooooooo', 'ooooooo'],
  N: ['ooo..oo', 'ooo..oo', 'oooo.oo', 'oo.o.oo', 'oo.oooo', 'oo..ooo', 'oo..ooo', 'oo...oo', 'oo...oo'],
  G: ['.ooooo.', 'oo...oo', 'oo.....', 'oo.....', 'oo..ooo', 'oo...oo', 'oo...oo', 'oo...oo', '.ooooo.'],
};

/** 单个字母 → 矩形列表（坐标相对字母自身左上角，已乘 UNIT）
 *
 *  这里**不做**精灵描边：船有描边是因为它是一张插画，只靠轮廓也认得出一艘船；
 *  而文字必须靠「字面 vs 天空」的明度差才读得出来 —— 描边一起上，字腔会被
 *  吃掉半格，浅色主题下整行字就糊成一团碎块。所以字面直接用主题的 --bc
 *  （浅色主题深字、深色主题亮字），永远是实的。
 */
function glyphRects(ch: string): { x: number; y: number; w: number; cls: string }[] {
  const rows = GLYPHS[ch] ?? [];
  const rects: { x: number; y: number; w: number; cls: string }[] = [];
  for (let y = 0; y < GH; y++) {
    let x = 0;
    while (x < GW) {
      if (rows[y]?.[x] !== 'o') {
        x++;
        continue;
      }
      let w = 1;
      while (x + w < GW && rows[y]?.[x + w] === 'o') w++;
      rects.push({ x: x * UNIT, y: y * UNIT, w: w * UNIT, cls: 'tide-word__ink' });
      x += w;
    }
  }
  return rects;
}

const LETTER_RECTS = WORD_TEXT.split('').map((ch) => glyphRects(ch));
const LETTER_STEP = GW + GAP; // 每个字母占的格数
const WORD_W = WORD_TEXT.length * GW + (WORD_TEXT.length - 1) * GAP;
const WORD_H = GH;
---

<div
  class="tide"
  data-tide
  data-state="intro"
  data-sea={SEA_DATA}
  transition:persist
>
  <!-- 天空：渐变 + 水平线附近的晨昏光 + 空中漂浮的星屑 -->
  <div class="tide__sky" aria-hidden="true">
    <span class="tide__spark" style="left: 12%; top: 24%; animation-delay: -1.2s"></span>
    <span class="tide__spark" style="left: 32%; top: 12%; animation-delay: -3.4s"></span>
    <span class="tide__spark" style="left: 58%; top: 20%; animation-delay: -2.1s"></span>
    <span class="tide__spark" style="left: 88%; top: 14%; animation-delay: -4.6s"></span>
    <!-- 水面反光：水平线下方一团暖光 -->
    <span class="tide__glare"></span>
  </div>

  <!-- 太阳（目的地）：随进度胀大 -->
  <div class="tide__sun" data-tide-sun aria-hidden="true"></div>

  <!--
    像素大字 LOADING：船开到哪个字母脚下，那个字母就点亮（光刃停在被点亮的边界上）。
    未点亮时是半透明的「幽灵字」，像还没通电的灯牌。
  -->
  <div class="tide__word" data-tide-word aria-hidden="true">
    <span class="tide__blade" data-tide-blade></span>
    <svg
      class="tide__word-svg"
      viewBox={`0 0 ${WORD_W * UNIT} ${WORD_H * UNIT}`}
      role="presentation"
    >
      {LETTER_RECTS.map((rects, i) => (
        <g class="tide__letter" data-letter={i}>
          <g transform={`translate(${i * LETTER_STEP * UNIT} 0)`}>
            <g class="tide__glyph">
              {rects.map((r) => (
                <rect class={r.cls} x={r.x} y={r.y} width={r.w} height={UNIT + 0.4} />
              ))}
            </g>
          </g>
        </g>
      ))}
    </svg>
  </div>

  <!-- 海：canvas 画三层浪，升降靠 transform 平移整块，不引发重排 -->
  <div class="tide__sea" data-tide-sea aria-hidden="true">
    <canvas class="tide__sea-canvas" data-tide-canvas></canvas>
  </div>

  <!-- 船：像素帆船 + 尾迹 + 船首水花。位置/俯仰由 loader.ts 每帧写 transform -->
  <div class="tide__boat" data-tide-boat aria-hidden="true">
    <div class="tide__boat-tilt" data-tide-tilt>
      <span class="tide__wake"></span>
      <span class="tide__hull-shadow"></span>
      <svg class="tide__ship" viewBox={`0 0 ${COLS * UNIT} ${ROWS * UNIT}`}>
        {SHIP_RECTS.map((r) => (
          <rect class={r.cls} x={r.x} y={r.y} width={r.w} height={UNIT + 0.4} />
        ))}
      </svg>
      <span class="tide__spray tide__spray--1"></span>
      <span class="tide__spray tide__spray--2"></span>
      <span class="tide__spray tide__spray--3"></span>
    </div>
  </div>

  <!-- 说明文字 + 进度：胶囊里整条从左往右填满，右边是百分比 -->
  <div class="tide__caption" data-tide-caption>
    <span class="tide__caption-fill" data-tide-fill aria-hidden="true"></span>
    <span class="tide__caption-inner">
      <svg class="tide__heart" viewBox="0 0 7 6" aria-hidden="true">
        <rect x="1" y="0" width="2" height="1"></rect>
        <rect x="4" y="0" width="2" height="1"></rect>
        <rect x="0" y="1" width="7" height="2"></rect>
        <rect x="1" y="3" width="5" height="1"></rect>
        <rect x="2" y="4" width="3" height="1"></rect>
        <rect x="3" y="5" width="1" height="1"></rect>
      </svg>
      <span class="tide__caption-text" data-tide-caption-text role="status" aria-live="polite"></span>
      <span class="tide__caption-pct" aria-hidden="true"><span data-tide-pct>0</span><span class="tide__caption-pct-unit">%</span></span>
    </span>
  </div>

  <!--
    canvas 配色探针：canvas 拿不到 CSS 变量（oklch(var(--p)) 是未解析的 token），
    所以用几个隐藏元素把「解析后的颜色」写在 background-color 上，JS 读计算值。
  -->
  <span class="tide__probe tide__probe--far" aria-hidden="true"></span>
  <span class="tide__probe tide__probe--mid" aria-hidden="true"></span>
  <span class="tide__probe tide__probe--near" aria-hidden="true"></span>
  <span class="tide__probe tide__probe--deep" aria-hidden="true"></span>
  <span class="tide__probe tide__probe--crest" aria-hidden="true"></span>
</div>

<noscript><style>[data-tide] { display: none; }</style></noscript>

<script>
  import '../scripts/loader';
</script>
