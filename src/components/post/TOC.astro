---
/**
 * 文章目录（树状 + 滚动轨迹）
 * ============================================================
 * 视觉结构（和参考稿一致）：
 *
 *   ● 文章标题                        ← 根节点（等价于「回到顶部」）
 *   │  ╰╮
 *   ●   一、重点            ⌄         ← 第一级：比标题缩进一格（45° 斜线下来）
 *   ┆     ╰─◆ 1、首页                ← 读到这里时自动展开
 *   ┆        ○ 2、音乐播放器           ← 还没读到：虚线 + 空心圆
 *   ●   二、用到的 AI 模型
 *
 * **标题级别自动识别**：正文里出现 h1~h6 任意几级都会自动收进目录，
 * 跳级（h2 后面直接 h4）也能正确挂到最近的父级下面（见 utils/toc.ts）。
 * 圆点大小按「树里的第几层」决定，所以文章怎么写层级视觉都一致。
 *
 * 三种形态：
 *   variant="sidebar"  左侧栏粘性卡片（桌面）
 *   variant="inline"   正文顶部可折叠卡片（竖屏，默认收起）
 *   + 悬浮窗           竖屏专用：inline 卡滑出视口后，把同一棵树钉在屏幕顶部
 *                      （DOM 里多一份树，但状态和上面那份共用 —— 见 scripts/toc.ts）
 *
 * 标题树来自 Astro 的 render() 返回的 headings（不自己解析 Markdown）；
 * 轨迹线 / 圆点 / 箭头全部由 src/scripts/toc.ts 按实时坐标绘制。
 */
import { Icon } from 'astro-icon/components';
import TOCTree from './TOCTree.astro';
import { buildTocTree, countTocNodes, type TocHeading } from '../../utils/toc';

interface Props {
  headings: TocHeading[];
  variant?: 'sidebar' | 'inline';
  /** 文章标题，作为目录树的根节点 */
  title: string;
  /**
   * 只收这几级标题（默认 1~6 全收）。
   * 系列章节（一章 = 一本书的一章）标题太多，传 maxDepth={3} 把 h4/h5 收掉，
   * 侧栏只留「讲 + 一级小节」这一层，翻起来才不晕。
   */
  minDepth?: number;
  maxDepth?: number;
  /**
   * 要不要给内联卡配一个竖屏悬浮窗（默认要）。
   * 悬浮窗只在窄屏出现：它的宽度、显隐都跟着内联卡走。
   */
  float?: boolean;
}

const {
  headings,
  variant = 'sidebar',
  title,
  minDepth = 1,
  maxDepth = 6,
  float = true,
} = Astro.props;

const nodes = buildTocTree(headings, minDepth, maxDepth);
const hasItems = nodes.length > 0;
const sectionCount = countTocNodes(nodes);
const inline = variant === 'inline';
const withFloat = inline && float && hasItems;
---

{
  hasItems && (
    <nav
      class:list={['toc-card card-neu card-neu--flat', inline && 'toc-card--inline']}
      aria-label="文章目录"
      data-toc
      data-toc-inline-card={inline ? '' : undefined}
      data-toc-variant={variant}
      data-pagefind-ignore
    >
      <div class="toc-head">
        <Icon name="material-symbols:list-rounded" class="toc-head__icon" />
        <span class="toc-head__title">目录</span>
        <span class="toc-head__count">{sectionCount} 节</span>

        <!-- 自动收起（手风琴）：开 = 只展开当前这一节 -->
        <button
          type="button"
          class="toc-tool"
          data-toc-auto
          aria-pressed="true"
          title="自动收起：开（只展开正在读的那一节）"
          aria-label="自动收起"
        >
          <Icon name="material-symbols:toggle-off" class="toc-tool__icon toc-tool__icon--off" />
          <Icon name="material-symbols:toggle-on" class="toc-tool__icon toc-tool__icon--on" />
        </button>

        <!-- 展开全部 / 收起全部 -->
        <button
          type="button"
          class="toc-tool"
          data-toc-expand
          aria-pressed="false"
          title="展开全部"
          aria-label="展开全部"
        >
          <Icon
            name="material-symbols:keyboard-double-arrow-down"
            class="toc-tool__icon toc-tool__icon--off"
          />
          <Icon
            name="material-symbols:keyboard-double-arrow-up"
            class="toc-tool__icon toc-tool__icon--on"
          />
        </button>

        {inline && (
          <button
            type="button"
            class="toc-tool"
            data-toc-fold
            aria-expanded="false"
            aria-label="收起目录"
          >
            <Icon name="material-symbols:keyboard-arrow-down" class="toc-tool__icon toc-tool__chevron" />
          </button>
        )}
      </div>

      <div class:list={['toc-foldable', inline && 'is-collapsed']} data-toc-foldable>
        <div class="toc-foldable__inner">
          <TOCTree nodes={nodes} title={title} />
        </div>
      </div>

      {/* 目录下面：阅读进度胶囊（文章页通过 footer 插槽塞进来） */}
      {
        Astro.slots.has('footer') && (
          <div class="toc-foot">
            <slot name="footer" />
          </div>
        )
      }
    </nav>
  )
}

{
  /* 竖屏悬浮目录
     ------------------------------------------------------------
     内联卡（上面的 nav）滑出视口之后就翻不到目录了，这里补一个钉在
     屏幕顶部的悬浮窗：同一棵树、同一套圆点/轨迹/纸飞机，只是窗口限高，
     纸飞机钉在窗口正中，文章往下滚 = 目录内容往上滑。

     显隐、窗口高度、滚轮/手指滑动全部由 scripts/toc.ts 接管：
       data-toc-shown  0/1  顶部内联卡滑出去了没有
       data-toc-open   0/1  展开 / 收起成一颗小胶囊（状态存 localStorage） */
  withFloat && (
    <div
      class="toc-float"
      data-toc
      data-toc-variant="float"
      data-toc-float
      data-toc-shown="0"
      data-toc-open="1"
      data-pagefind-ignore
    >
      <div class="toc-float__panel" role="navigation" aria-label="悬浮目录">
        <div class="toc-head toc-head--float">
          <Icon name="material-symbols:list-rounded" class="toc-head__icon" />
          <span class="toc-head__title">目录</span>
          <span class="toc-head__count">{sectionCount} 节</span>

          <button
            type="button"
            class="toc-tool"
            data-toc-auto
            aria-pressed="true"
            title="自动收起：开（只展开正在读的那一节）"
            aria-label="自动收起"
          >
            <Icon name="material-symbols:toggle-off" class="toc-tool__icon toc-tool__icon--off" />
            <Icon name="material-symbols:toggle-on" class="toc-tool__icon toc-tool__icon--on" />
          </button>

          <button
            type="button"
            class="toc-tool"
            data-toc-expand
            aria-pressed="false"
            title="展开全部"
            aria-label="展开全部"
          >
            <Icon
              name="material-symbols:keyboard-double-arrow-down"
              class="toc-tool__icon toc-tool__icon--off"
            />
            <Icon
              name="material-symbols:keyboard-double-arrow-up"
              class="toc-tool__icon toc-tool__icon--on"
            />
          </button>

          {/* 收起悬浮窗（变成顶部那颗小胶囊） */}
          <button
            type="button"
            class="toc-tool toc-tool--float-fold"
            data-toc-float-fold
            aria-expanded="true"
            title="收起悬浮目录"
            aria-label="收起悬浮目录"
          >
            <Icon
              name="material-symbols:keyboard-arrow-up-rounded"
              class="toc-tool__icon toc-tool__chevron-up"
            />
          </button>
        </div>

        <TOCTree nodes={nodes} title={title} />
      </div>

      {/* 收起后的小胶囊：点一下再展开。底色从左往右长 = 阅读进度（和正文页
          底部那颗进度条同一套算法/配色，见 scripts/toc.ts 的 syncPillProgress） */}
      <button
        type="button"
        class="toc-float__pill"
        data-toc-float-pill
        aria-expanded="false"
        title="展开悬浮目录"
        aria-label="展开悬浮目录"
      >
        <span class="toc-float__pill-fill" data-toc-float-fill aria-hidden="true" />
        <Icon name="material-symbols:list-rounded" class="toc-float__pill-icon" />
        <span class="toc-float__pill-text">目录</span>
        <span class="toc-float__pill-count">{sectionCount} 节</span>
        <span class="toc-float__pill-pct" data-toc-float-pct>
          <span data-toc-float-pct-value>0</span><i>%</i>
        </span>
        <Icon name="material-symbols:keyboard-arrow-down-rounded" class="toc-float__pill-chevron" />
      </button>
    </div>
  )
}

<script>
  import '../../scripts/toc';
</script>
