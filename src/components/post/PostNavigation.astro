---
/**
 * 上一篇 / 下一篇（两张卡片）
 */
import { Icon } from 'astro-icon/components';
import type { Post } from '../../utils/posts';
import { postUrl } from '../../utils/posts';
import { formatDate } from '../../utils/date';
import { SITE } from '../../site.config';

interface Props {
  newer?: Post;
  older?: Post;
}

const { newer, older } = Astro.props;
---

{
  (newer || older) && (
    <nav class="mt-5 grid gap-3 sm:grid-cols-2" aria-label="上下篇导航" data-pagefind-ignore>
      {older ? (
        <a href={postUrl(older)} class="card-neu group flex flex-col gap-1 p-4">
          <span class="flex items-center gap-1 text-xs text-base-content/45">
            <Icon name="material-symbols:arrow-back-rounded" class="h-3.5 w-3.5" />
            上一篇
          </span>
          <span class="line-clamp-2 text-sm font-semibold leading-snug transition-colors group-hover:text-primary">
            {older.data.title}
          </span>
          <span class="text-[0.6875rem] text-base-content/35">
            {formatDate(older.data.date, SITE.dateFormat)}
          </span>
        </a>
      ) : (
        <span class="hidden sm:block" />
      )}

      {newer ? (
        <a href={postUrl(newer)} class="card-neu group flex flex-col items-end gap-1 p-4 text-right">
          <span class="flex items-center gap-1 text-xs text-base-content/45">
            下一篇
            <Icon name="material-symbols:arrow-forward-rounded" class="h-3.5 w-3.5" />
          </span>
          <span class="line-clamp-2 text-sm font-semibold leading-snug transition-colors group-hover:text-primary">
            {newer.data.title}
          </span>
          <span class="text-[0.6875rem] text-base-content/35">
            {formatDate(newer.data.date, SITE.dateFormat)}
          </span>
        </a>
      ) : (
        <span class="hidden sm:block" />
      )}
    </nav>
  )
}
