---
/**
 * Banner（顶部横幅）
 * ============================================================
 * · 双层背景图交叉淡入轮播（8s，可在 config/site.json 改）
 * · 黑色遮罩（overlay 0.4）压暗背景，保证白字可读
 * · 底部 4 层波浪收口，填充色跟随主题
 * · 标题/副标题按页面 id 从 config/site.json → pages.* 取
 * · 首页与文章页副标题用打字机效果
 *
 * 三档模式（默认/全屏/隐藏/背景）由 <html data-banner-mode> 控制，
 * 状态与切换逻辑在 src/scripts/theme.ts。
 */
import { BANNER, pageText } from '../../site.config';

interface Props {
  /** 页面 id，对应 config/site.json → pages 里的键 */
  pageId?: string;
  /** 是否启用打字机（首页、文章页传 true） */
  typewriter?: boolean;
}

const { pageId = 'home', typewriter = false } = Astro.props;
const text = pageText(pageId);

const images = BANNER.images.length ? BANNER.images : ['/banner/1.svg'];
const lines = typewriter ? (text.typewriter ?? []) : [];
const hasTypewriter = lines.length > 0;
---

<section
  class="banner"
  data-banner
  data-images={JSON.stringify(images)}
  data-interval={BANNER.interval}
  style={`--banner-h: ${BANNER.height}; --banner-overlay: ${BANNER.overlay};`}
  aria-label={text.title}
>
  <!-- 两层背景：JS 交替淡入 -->
  <div
    class="banner__layer"
    data-banner-layer
    style={`background-image: url("${images[0]}")`}
    role="img"
    aria-label="横幅背景图"
  ></div>
  <div class="banner__layer" data-banner-layer aria-hidden="true"></div>

  <!-- 遮罩 -->
  <div class="banner__scrim"></div>

  <!-- 文字 -->
  <div class="banner__content">
    <h1 class="banner__title">{text.title}</h1>
    {
      hasTypewriter ? (
        <p class="banner__subtitle">
          <span data-typewriter={JSON.stringify(lines)}></span>
          <span class="banner__caret" aria-hidden="true" />
        </p>
      ) : (
        text.subtitle && <p class="banner__subtitle">{text.subtitle}</p>
      )
    }
  </div>

  <!-- 波浪收口
       结构照搬参考站（RyuChan `src/components/Banner.astro` 的 .waves）：
       同一条波形路径叠 4 层 <use>，每层 y 略微下移、透明度递增、速度递减，
       靠 CSS 把整层沿 X 平移「恰好一个波长」，于是形成不断向右推进的浪。
       数学关系（改动前请先读 docs/redesign-plan.md §10.1）：
         · 单段浪 = 88 用户单位，一个完整起伏（波谷→波谷）= 176 单位
         · 路径 8 段 = 704 单位，x 偏移 48 → 屏幕坐标 [-112, 592]；
           平移范围 ±88 时，任意时刻覆盖区都包住可见的 [0, 320]，不会露边
         · 平移 -88px → +88px = 一个波长 → 首尾无缝、方向朝右
         · viewBox 宽 320 ≈ 1.8 个波长，宽屏上能同时看到 2 个浪头 -->
  <svg
    class="banner__waves"
    viewBox="0 24 320 28"
    preserveAspectRatio="none"
    shape-rendering="auto"
    aria-hidden="true"
  >
    <defs>
      <path
        id="banner-wave"
        d="M-160 44c30 0 58-18 88-18s58 18 88 18 58-18 88-18 58 18 88 18 58-18 88-18 58 18 88 18 58-18 88-18 58 18 88 18 58-18 88-18 58 18 88 18 58-18 88-18 58 18 88 18v44h-704z"></path>
    </defs>
    <g>
      <use href="#banner-wave" class="banner__wave banner__wave--1" x="48" y="0"></use>
      <use href="#banner-wave" class="banner__wave banner__wave--2" x="48" y="3"></use>
      <use href="#banner-wave" class="banner__wave banner__wave--3" x="48" y="5"></use>
      <use href="#banner-wave" class="banner__wave banner__wave--4" x="48" y="7"></use>
    </g>
  </svg>
</section>

<script>
  import '../../scripts/banner';
</script>
