---
/**
 * 空态提示（没有文章 / 没有相册 / 搜索无结果）
 */
import { Icon } from 'astro-icon/components';

interface Props {
  title?: string;
  hint?: string;
  /** iconify 图标名 */
  icon?: string;
}

const {
  title = '这里还什么都没有',
  hint = '',
  icon = 'material-symbols:inbox-outline',
} = Astro.props;
---

<div class="card-neu card-neu--flat flex flex-col items-center gap-2 px-6 py-12 text-center">
  <Icon name={icon} class="h-10 w-10 text-base-content/25" />
  <p class="text-sm font-medium text-base-content/70">{title}</p>
  {hint && <p class="text-xs text-base-content/45">{hint}</p>}
  <slot />
</div>
