---
/**
 * 快捷入口卡（首页顶部 2×2）
 * ------------------------------------------------------------
 * 归档 / 分类 / 标签 / 搜索，四个高频入口。
 */
import { Icon } from 'astro-icon/components';

const links = [
  {
    href: '/archive/',
    icon: 'material-symbols:calendar-month-outline',
    label: '归档',
    hint: '按年月浏览',
  },
  {
    href: '/categories/',
    icon: 'material-symbols:folder-outline',
    label: '分类',
    hint: '按主题浏览',
  },
  {
    href: '/tags/',
    icon: 'material-symbols:sell-outline',
    label: '标签',
    hint: '按关键词浏览',
  },
  {
    href: '/search/',
    icon: 'material-symbols:search-rounded',
    label: '搜索',
    hint: '全文检索',
  },
];
---

<div class="mb-6 grid grid-cols-2 gap-3">
  {
    links.map((link) => (
      <a href={link.href} class="card-neu group flex items-center gap-3 p-4">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-neu bg-primary/10 text-primary transition-colors group-hover:bg-primary group-hover:text-primary-content">
          <Icon name={link.icon} class="h-5 w-5" />
        </span>
        <span class="min-w-0">
          <span class="block text-sm font-semibold leading-tight">{link.label}</span>
          <span class="mt-0.5 block truncate text-[0.6875rem] text-base-content/45">{link.hint}</span>
        </span>
      </a>
    ))
  }
</div>
