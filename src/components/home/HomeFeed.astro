---
/**
 * 首页信息流（第 1 页与 /page/N/ 共用）
 * ------------------------------------------------------------
 * 竖屏个人卡（仅 <1024px）→ 快捷入口卡（仅第 1 页）→ 文章卡片列表 → 分页。
 * 阅读/点赞数由 PostMetaScript 批量填充。
 *
 * 系列（多文件长文）不走单独的卡片：它的「导读页」就是列表里的一条普通文章，
 * 由 PostCard 统一渲染（带一个「学习笔记 · 系列长文 · N 章」的角标），
 * 章节本身不在列表里出现。
 */
import type { Post } from '../../utils/posts';
import PostCard from '../card/PostCard.astro';
import PostMetaScript from '../card/PostMetaScript.astro';
import QuickLinks from './QuickLinks.astro';
import ProfileCompact from '../sidebar/ProfileCompact.astro';
import Pagination from '../widgets/Pagination.astro';
import EmptyState from '../widgets/EmptyState.astro';

interface Props {
  posts: Post[];
  /** 当前页（从 1 开始） */
  page: number;
  /** 总页数 */
  totalPages: number;
  /** 是否显示顶部快捷入口卡，默认仅第 1 页显示 */
  showQuickLinks?: boolean;
}

const { posts, page, totalPages, showQuickLinks = page === 1 } = Astro.props;
---

{/* 竖屏没有侧栏，把个人卡（头像 / 站名 / 签名 / 社交）放到快捷入口上方 */}
<ProfileCompact />

{showQuickLinks && <QuickLinks />}

{
  posts.length === 0 ? (
    <EmptyState
      title="还没有文章"
      hint="在 src/content/posts/ 里新建一个 .md 文件，或者登录后从「写文章」开始。"
      icon="material-symbols:article-outline"
    />
  ) : (
    <div class="flex flex-col gap-4">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  )
}

<Pagination current={page} total={totalPages} />

<PostMetaScript />
