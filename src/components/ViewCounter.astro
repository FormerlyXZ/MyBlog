---
/**
 * 文章页的「阅读 N 次」
 * ------------------------------------------------------------
 * 页面加载时向 Worker 上报一次阅读（后端按 IP 30 分钟内去重，刷新不会刷量），
 * 拿回最新数字显示。连不上服务时整段隐藏，不留空壳。
 */
import { Icon } from 'astro-icon/components';

interface Props {
  /** 文章路径，如 /posts/hello-world/ */
  path: string;
}

const { path } = Astro.props;
---

<span
  class="inline-flex items-center gap-1 text-xs text-base-content/55"
  data-view-counter
  data-path={path}
  data-pagefind-ignore
  hidden
>
  <Icon name="material-symbols:visibility-outline" class="h-4 w-4" />
  <span data-view-count>—</span>
</span>

<script>
  import { sendView } from '../utils/site';
  import { onPageLoad } from '../scripts/pageload';

  function initCounter(): void {
    const counter = document.querySelector<HTMLElement>('[data-view-counter]');
    if (!counter) return;
    // 换页后 DOM 是新元素；同一元素不重复上报
    if (counter.dataset.init === '1') return;
    counter.dataset.init = '1';

    const path = counter.dataset.path || location.pathname;
    const countEl = counter.querySelector<HTMLElement>('[data-view-count]');

    sendView(path)
      .then((result) => {
        if (!countEl) return;
        countEl.textContent = result.count.toLocaleString('zh-CN');
        counter.hidden = false;
      })
      .catch(() => {
        // 点赞/统计服务不可用时保持隐藏，不影响阅读
      });
  }

  onPageLoad(initCounter);
</script>
