---
/**
 * 全站布局
 * ============================================================
 * 结构（从上到下）：
 *   <head>  防闪屏主题脚本 → ClientRouter → SEO meta
 *   Banner  顶部横幅（可切 默认/全屏/隐藏/背景）
 *   Nav     悬浮毛玻璃胶囊（桌面 / 移动两套）
 *   布局    双栏：左栏粘性侧栏（插槽 sidebar）+ 右栏正文
 *   Footer  卡片式页脚
 *
 * 页面只需写自己的内容（默认插槽）和可选的侧栏（sidebar 插槽）。
 * ============================================================
 */
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { ADMIN_OWNERS, ANALYTICS } from '../consts';
import { SITE, SITE_URL, THEME, GISCUS, GISCUS_ENABLED, BANNER } from '../site.config';
import { THEME_LIST } from '../utils/theme';
import Banner from '../components/banner/Banner.astro';
import DesktopNav from '../components/nav/DesktopNav.astro';
import MobileNav from '../components/nav/MobileNav.astro';
import Footer from '../components/Footer.astro';
import MiniPlayer from '../components/music/MiniPlayer.astro';
import ProfileBar from '../components/sidebar/ProfileBar.astro';

interface Props {
  /** 页面标题，不传则只用站点标题 */
  title?: string;
  /** 页面描述，用于 SEO */
  description?: string;
  /** 页面类型 */
  type?: 'website' | 'article';
  /** 文章发布时间（文章页传） */
  publishedAt?: Date;
  /** 文章更新时间（文章页传，可选） */
  updatedAt?: Date;
  /** 文章标签（文章页传） */
  tags?: string[];
  /** 告诉搜索引擎不要收录这个页面 */
  noindex?: boolean;
  /** 是否参与站内全文搜索（Pagefind），工具页传 false */
  indexable?: boolean;
  /** 是否显示 Banner，默认显示 */
  banner?: boolean;
  /** Banner 文案取 config/site.json → pages 里的哪个键，默认按路径推断 */
  pageId?: string;
  /** Banner 副标题是否用打字机（首页、文章页传 true） */
  typewriter?: boolean;
  /** 是否带左侧栏，默认带；工具类页面可传 false 让正文占满 */
  sidebar?: boolean;
}

const {
  title,
  description = SITE.description,
  type = 'website',
  publishedAt,
  updatedAt,
  tags = [],
  noindex = false,
  indexable = true,
  banner = true,
  pageId,
  typewriter = false,
  sidebar = true,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const rssUrl = new URL('rss.xml', SITE_URL).href;

/**
 * 站点图标（config/site.json → site.favicon）的 MIME 类型与 sizes。
 * 以前写死 image/svg+xml，换成 PNG 之后 type 和真实内容对不上，
 * 有些浏览器会直接忽略这个图标（标签页变成空白 / 默认地球）。
 */
const faviconIsSvg = SITE.favicon.toLowerCase().endsWith('.svg');
const faviconType = faviconIsSvg
  ? 'image/svg+xml'
  : SITE.favicon.toLowerCase().endsWith('.png')
    ? 'image/png'
    : 'image/x-icon';
/** SVG 是矢量，标 any；位图不写 sizes，让浏览器按实际尺寸用 */
const faviconSizes = faviconIsSvg ? 'any' : undefined;

/** 按路径推断 Banner 文案来源，页面也可以自己传 pageId 覆盖 */
function inferPageId(pathname: string): string {
  const path = pathname.replace(/^\/+|\/+$/g, '');
  if (!path) return 'home';
  const first = path.split('/')[0] ?? '';
  const known = [
    'about',
    'navigation',
    'project',
    'album',
    'moments',
    'music',
    'archive',
    'categories',
    'tags',
    'search',
  ];
  if (known.includes(first)) return first;
  if (first === 'posts') return 'home';
  return 'home';
}

const resolvedPageId = pageId ?? inferPageId(Astro.url.pathname);
const hasSidebarSlot = Astro.slots.has('sidebar');
---

<!doctype html>
<html
  lang={SITE.language}
  data-theme={THEME.light}
  data-theme-type="light"
  data-banner-mode={THEME.bannerMode}
  data-theme-light={THEME.light}
  data-theme-dark={THEME.dark}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />

    <!-- 站点图标：类型按扩展名推断（以前写死 image/svg+xml，
         换成 PNG 之后浏览器会因为 type 跟实际内容对不上而忽略这个图标） -->
    <link rel="icon" href={SITE.favicon} type={faviconType} sizes={faviconSizes} />
    <link rel="apple-touch-icon" href={SITE.favicon} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.title} RSS`}
      href={rssUrl}
    />

    <!-- Open Graph / 社交分享 -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="zh_CN" />
    {publishedAt && (
      <meta property="article:published_time" content={publishedAt.toISOString()} />
    )}
    {updatedAt && (
      <meta property="article:modified_time" content={updatedAt.toISOString()} />
    )}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary" />

    <!--
      防闪屏：在页面渲染前就把 data-theme / data-theme-type / data-banner-mode 设好，
      避免「先白后黑」的闪屏。
      优先级：上次手动选择 > 系统偏好 > config/site.json 里配的默认值
    -->
    <script
      is:inline
      define:vars={{
        defaultLight: THEME.light,
        defaultDark: THEME.dark,
        defaultBannerMode: THEME.bannerMode,
        themeNames: THEME_LIST.map((t) => t.name),
        darkThemes: THEME_LIST.filter((t) => t.dark).map((t) => t.name),
        bannerModes: ['default', 'fullscreen', 'hidden', 'background'],
      }}
    >
      (function () {
        var root = document.documentElement;
        try {
          // ---- 配色 ----
          var stored = localStorage.getItem('theme');
          // 老版本存的是 light/dark，不是 daisyUI 主题名，直接作废
          if (!stored || themeNames.indexOf(stored) === -1) stored = null;

          if (!stored) {
            var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            stored = prefersDark ? defaultDark : defaultLight;
          }

          root.dataset.theme = stored;
          root.dataset.themeType = darkThemes.indexOf(stored) === -1 ? 'light' : 'dark';

          // ---- Banner 模式 ----
          var mode = localStorage.getItem('banner-mode');
          if (!mode || bannerModes.indexOf(mode) === -1) mode = defaultBannerMode;
          root.dataset.bannerMode = mode;

          // 首屏先关掉过渡，避免主题色渐变闪一下
          root.classList.add('no-transition');
          window.addEventListener('load', function () {
            root.classList.remove('no-transition');
          });
        } catch (e) {
          root.dataset.theme = defaultLight;
          root.dataset.themeType = 'light';
          root.dataset.bannerMode = defaultBannerMode;
        }
      })();
    </script>

    {
      /* Cloudflare Web Analytics：在 src/consts.ts 里填了 token 才会加载 */
      ANALYTICS.cloudflareToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: ANALYTICS.cloudflareToken })}
        />
      )
    }

    {
      /* Banner 首图随机（静态站服务端随机不了，就在 <head> 里先掷一次骰子）：
         结果写成 --banner-start，Banner 第一层的 background-image 用 var() 取它 ——
         于是**第一次绘制就是随机那张**，不会「先显示 1 号图再换一张」闪一下。
         同一次浏览里尽量避开上一张（sessionStorage），刷新时不会连着两次撞图。
         banner.ts 会读 window.__bannerStartIndex，从这个下标继续轮播。 */
    }
    <script is:inline define:vars={{ bannerImages: BANNER.images }}>
      (function () {
        var imgs = bannerImages || [];
        if (!imgs.length) return;

        var win = window;
        var root = document.documentElement;

        if (typeof win.__bannerStartIndex !== 'number') {
          var index = 0;
          if (imgs.length > 1) {
            var last = -1;
            try {
              var raw = sessionStorage.getItem('banner-last');
              if (raw !== null) last = parseInt(raw, 10);
            } catch (e) {}

            // 有「上一张」时把它从候选里剔掉，在剩下的图里等概率抽一张
            var skipLast = last >= 0 && last < imgs.length;
            var pool = skipLast ? imgs.length - 1 : imgs.length;
            index = Math.floor(Math.random() * pool);
            if (skipLast && index >= last) index++;

            try {
              sessionStorage.setItem('banner-last', String(index));
            } catch (e) {}
          }
          win.__bannerStartIndex = index;
        }

        var picked = imgs[win.__bannerStartIndex] || imgs[0];
        root.style.setProperty('--banner-start', 'url("' + picked + '")');
      })();
    </script>

    <ClientRouter />
  </head>

  <body
    class="min-h-screen bg-base-200 font-sans text-base-content antialiased"
    data-admin-owners={JSON.stringify(ADMIN_OWNERS)}
    data-giscus-lang={GISCUS.lang}
    data-giscus-enabled={GISCUS_ENABLED ? '1' : '0'}
  >
    <a class="skip-link" href="#main">跳到正文</a>

    {banner && <Banner pageId={resolvedPageId} typewriter={typewriter} />}

    <!-- 悬浮导航：滚到下方自动收起（scripts/nav.ts） -->
    <div class="nav-shell" data-nav-shell>
      <div class="glass-nav nav-bar">
        <DesktopNav />
        <MobileNav />
      </div>
    </div>

    <!--
      导航隐现：向下滚收起 / 一往上滚恢复 / 指针滑到 Banner 上让位 /
      指针贴到页面顶部唤回来。脚本作用在 .nav-shell 上，
      所以放在布局里（不是 DesktopNav）—— 桌面的还是移动的胶囊都归它管。
    -->
    <script>
      import '../scripts/nav';
    </script>

    <!--
      滚轮惯性：滚轮停下后，页面还会顺着原方向滑一小段再收住。
      窗口级监听，模块只执行一次 —— 不需要按页重新初始化。
    -->
    <script>
      import '../scripts/smooth-wheel';
    </script>

    <main id="main" class={banner ? 'layout layout--overlap' : 'layout pt-24'}>
      <div class={`layout__grid ${sidebar ? 'layout__grid--with-sidebar' : ''}`}>
        {
          sidebar && (
            <aside class="layout__sidebar" aria-label="侧栏">
              {hasSidebarSlot ? <slot name="sidebar" /> : <ProfileBar />}
            </aside>
          )
        }

        <div class="layout__main" data-pagefind-body={indexable ? '' : undefined}>
          <slot />
        </div>
      </div>
    </main>

    <Footer />

    <!--
      全站音乐播放器：左下角那张小碟片。
      带 transition:persist，换页时元素（连同里面的 <audio>）不会被替换，
      所以点开一篇文章、翻到相册，歌都不会断。
    -->
    <MiniPlayer />

    <!--
      站长入口显隐：只对站长显示「写文章 / 站点配置 / 统计 / 编辑本篇」。
      ① 本浏览器授权过写作权限（localStorage['melodyxz-edit']）；或
      ② 用 ADMIN_OWNERS 里的 GitHub 账号登录过本站（localStorage['melodyxz-user']）。
      访客看不到；伪造也进不去（权限在 GitHub 那边）。
    -->
    <script is:inline>
      (function () {
        function apply() {
          var owners = [];
          try {
            owners = JSON.parse(document.body.getAttribute('data-admin-owners') || '[]');
          } catch (e) {}

          var show = false;
          try {
            if (localStorage.getItem('melodyxz-edit')) show = true;
            if (!show) {
              var raw = localStorage.getItem('melodyxz-user');
              if (raw && owners.length) {
                var session = JSON.parse(raw);
                show = Boolean(
                  session &&
                    typeof session.login === 'string' &&
                    owners.indexOf(session.login) !== -1,
                );
              }
            }
          } catch (e) {
            show = false;
          }

          // [data-admin-link] 是链接，[data-admin-only] 是任意元素（按钮/区块）
          var links = document.querySelectorAll('[data-admin-link], [data-admin-only]');
          for (var i = 0; i < links.length; i++) {
            links[i].hidden = !show;
          }
        }

        apply();
        // 换页后重新判定（ClientRouter 会替换 DOM）+ 登录/退出后实时刷新
        document.addEventListener('astro:page-load', apply);
        window.addEventListener('melodyxz:auth', apply);
      })();
    </script>
  </body>
</html>
