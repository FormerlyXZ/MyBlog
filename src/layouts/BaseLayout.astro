---
import '../styles/global.css';
import { ADMIN_OWNERS, ANALYTICS, SITE, SITE_URL } from '../consts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  /** 页面标题，不传则只用站点标题 */
  title?: string;
  /** 页面描述，用于 SEO */
  description?: string;
  /** 页面类型 */
  type?: 'website' | 'article';
  /** 文章发布时间（文章页传） */
  publishedAt?: Date;
  /** 文章标签（文章页传） */
  tags?: string[];
  /** 告诉搜索引擎不要收录这个页面（如统计页、搜索页） */
  noindex?: boolean;
  /**
   * 是否参与站内全文搜索（Pagefind）。
   * 默认参与；搜索页、404、统计页这类工具页面传 false。
   * 原理：页面加了 data-pagefind-body 才会被索引，页头页脚自动忽略。
   */
  indexable?: boolean;
}

const {
  title,
  description = SITE.description,
  type = 'website',
  publishedAt,
  tags = [],
  noindex = false,
  indexable = true,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const rssUrl = new URL('rss.xml', SITE_URL).href;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <!-- 站点图标 -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.title} RSS`}
      href={rssUrl}
    />

    <!-- Open Graph / 社交分享 -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="zh_CN" />
    {publishedAt && (
      <meta property="article:published_time" content={publishedAt.toISOString()} />
    )}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary" />

    <!--
      主题初始化：在页面渲染前就把 data-theme 设好，避免"先白后黑"的闪屏。
      优先级：用户上次手动选择 > 系统偏好
    -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var system = window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
          var theme = stored === 'light' || stored === 'dark' ? stored : system;
          document.documentElement.dataset.theme = theme;
          document.documentElement.classList.add('no-transition');
          window.addEventListener('load', function () {
            document.documentElement.classList.remove('no-transition');
          });
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>

    {
      /* Cloudflare Web Analytics：在 src/consts.ts 里填了 token 才会加载，留空不影响任何东西 */
      ANALYTICS.cloudflareToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: ANALYTICS.cloudflareToken })}
        />
      )
    }
  </head>
  <body data-admin-owners={JSON.stringify(ADMIN_OWNERS)}>
    <a class="skip-link" href="#main">跳到正文</a>
    <Header />
    <main id="main" class="site-main" data-pagefind-body={indexable ? '' : undefined}>
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer />

    {
      /* 后台入口（写文章 / 统计 / 编辑本篇）只对站长显示：
         ① 在这个浏览器里登录过一次 /admin/；或
         ② 用 ADMIN_OWNERS 里的 GitHub 账号登录过本站。
         访客看不到，伪造也进不去后台（权限在 GitHub 那边）。 */
    }
    <script is:inline>
      (function () {
        var owners = [];
        try {
          owners = JSON.parse(document.body.getAttribute('data-admin-owners') || '[]');
        } catch (e) {}

        function shouldShow() {
          try {
            if (localStorage.getItem('melodyxz-admin')) return true;
            var raw = localStorage.getItem('melodyxz-user');
            if (!raw || !owners.length) return false;
            var session = JSON.parse(raw);
            return Boolean(session && typeof session.login === 'string' && owners.indexOf(session.login) !== -1);
          } catch (e) {
            return false;
          }
        }

        function apply() {
          if (!shouldShow()) return;
          document.querySelectorAll('[data-admin-link]').forEach(function (el) {
            el.hidden = false;
          });
        }

        apply();
        // 登录/退出后（点赞那套 GitHub 登录）实时刷新入口
        window.addEventListener('melodyxz:auth', apply);
      })();
    </script>
  </body>
</html>
