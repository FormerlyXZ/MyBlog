---
/**
 * 首页 = 分页文章列表（第 1 页）
 * ============================================================
 * · 左侧栏：个人卡 / 搜索 / 分类 / 标签 / 站长工具（BaseLayout 提供双栏）
 * · 右侧：快捷入口卡 + 文章卡片 + 分页
 * · 第 2…N 页在 /page/[page].astro，内容由 HomeFeed 共用
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeFeed from '../components/home/HomeFeed.astro';
import Sidebar from '../components/sidebar/Sidebar.astro';
import { getSortedPosts } from '../utils/posts';
import { BLOG_PAGE_SIZE, SITE } from '../site.config';

const posts = await getSortedPosts();
const totalPages = Math.max(1, Math.ceil(posts.length / BLOG_PAGE_SIZE));
const pagePosts = posts.slice(0, BLOG_PAGE_SIZE);
---

<BaseLayout
  title={undefined}
  description={SITE.description}
  typewriter
  pageId="home"
>
  <Fragment slot="sidebar">
    <Sidebar />
  </Fragment>

  <HomeFeed posts={pagePosts} page={1} totalPages={totalPages} />
</BaseLayout>
