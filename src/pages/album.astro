---
/**
 * 相册 = 照片墙（2026-12 第三次重做：格点 + 比例吸附）
 * ============================================================
 * 波浪 Banner 是「幕布」：滚轮往下，它像帘子一样升起来，照片海整屏接管。
 * 进入后：
 *   · 画布比屏幕宽好几倍，按住左键能往上下左右拖（带橡皮筋回弹）
 *   · 滚轮完全不接管 —— 它只负责滚页面（也就是掀幕布）
 *   · 缩略图一律裁成比例菜单里的九档之一（9:16 … 3:1），高度都是整数格 ——
 *     于是「不重叠 / 不留缝 / 上下两条边齐」是构造上成立的（见 docs/album-wall.md §3）
 *   · 点一张照片 → 原地放大成「同一档比例的放大版」，占整数列（横向铺满那 k 列，左右不留空档），
 *     高度优先装进「导航下面那块可用区」；被它压到的照片才让开，其余一动不动；
 *     压暗，相机把它推到可用区正中
 *   · 再点一下 → 灯箱（原比例），滚轮以光标为中心缩放、拖动查看、左右切换
 *   · 左侧竖向分类栏，可收起（展示哪些分类由 gallery.json 的 `railTags` 决定）
 *   · 右下角竖向胶囊：上面那颗切「随机 / 顺序」，下面那颗「回到正中」
 *     （排序只影响排版顺序和灯箱里 ← → 的先后，记在本机，不写进仓库）
 *
 * 排版全部在客户端算（视口宽高决定列宽/列数），所以这里只输出
 * 「一堆带真实尺寸的按钮 + 数据属性」，位置由 scripts/gallery-wall.ts 写。
 *
 * 没有 JS 时的兜底：<noscript> 里的样式把它变成普通的三列瀑布（见文件末尾）。
 *
 * ⚠ DOM 契约（scripts/gallery-wall.ts 依赖，改名前先看那个文件）：
 *   data-gal / data-gal-settings / data-gal-mode
 *   data-gal-curtain / data-gal-spacer / data-gal-stars
 *   data-gal-view / data-gal-stage / data-gal-dim / data-gal-glow
 *   data-gal-cell + data-id + data-w + data-h + data-tags + data-src / -title / -desc / -date
 *   data-gal-rail / data-gal-rail-toggle / data-gal-tag / data-gal-count
 *   data-gal-dock / data-gal-action="order" / data-gal-action="reset"
 *   data-gal-hint / data-gal-empty
 *   data-gal-lb / -canvas / -img / -cap / -count / -prev / -next / -close / -zin / -zout / -fit
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Banner from '../components/banner/Banner.astro';
import { Icon } from 'astro-icon/components';
import { PAGE_TEXTS } from '../site.config';
import { getPhotos, getSettings, getTagFilter, getVisibleTags } from '../utils/gallery';

const photos = getPhotos();
const settings = getSettings();
// 左侧栏展示哪些分类由 config/gallery.json 的 railTags 决定（空 = 全部）
const tagFilter = getTagFilter();
const tags = getVisibleTags(photos);
// 白名单生效时在抽屉的 aria 描述里说清楚，别让人以为标签丢了
const railLabel = tagFilter.length ? `照片分类（展示 ${tags.length} 个）` : '照片分类';
const text = PAGE_TEXTS.album ?? { title: '相册', subtitle: '记录生活中的美好瞬间' };

/** 设置转成 CSS 变量（排版数值由脚本算，这里只给纯装饰性的几项） */
const styleVars = [
  `--gal-gap:${settings.gap}px`,
  `--gal-radius:${settings.radius}px`,
  `--gal-dim:${settings.dim}`,
].join(';');
---

<BaseLayout
  title={text.title}
  description={text.subtitle}
  pageId="album"
  banner={false}
  sidebar={false}
  fullBleed
  footer={false}
  htmlClass="gal-page"
>
  <!-- 幕布：直接参与页面滚动（不是 transform 追着滚轮跑）——
       滚轮往下它自然被顶上去，照片海在它后面（fixed）纹丝不动；
       滚回去它自然又落下来。所见即所得，永不「慢一拍」。 -->
  <div class="gal-curtain" data-gal-curtain>
    <Banner pageId="album" />
  </div>

  <div
    class="gal"
    data-gal
    data-gal-mode="camera"
    data-gal-settings={JSON.stringify(settings)}
    style={styleVars}
  >
    <!-- 照片海外面的「空间」 -->
    <canvas class="gal-stars" data-gal-stars aria-hidden="true"></canvas>

    <!-- 画布视口 -->
    <div class="gal-view" data-gal-view>
      <div class="gal-stage" data-gal-stage>
        <div class="gal-glow" data-gal-glow aria-hidden="true"></div>

        {
          photos.map((photo, index) => (
            <button
              type="button"
              class="gal-cell"
              data-gal-cell
              data-id={photo.id}
              data-w={photo.w}
              data-h={photo.h}
              data-tags={(photo.tags ?? []).join(' ')}
              data-src={photo.src}
              data-title={photo.title ?? ''}
              data-desc={photo.description ?? ''}
              data-date={photo.date ?? ''}
              aria-label={photo.title || `查看第 ${index + 1} 张照片`}
            >
              <img
                src={photo.src}
                alt={photo.title || `照片 ${index + 1}`}
                width={photo.w}
                height={photo.h}
                loading={index < 16 ? 'eager' : 'lazy'}
                decoding="async"
                draggable="false"
              />
              {photo.title && <span class="gal-cell__cap">{photo.title}</span>}
            </button>
          ))
        }
      </div>

      <div class="gal-dim" data-gal-dim aria-hidden="true"></div>

      {
        photos.length === 0 && (
          <p class="gal-empty" data-gal-empty>
            照片海还是空的。登录后到「站点配置 → 照片墙」上传第一批照片吧。
          </p>
        )
      }
    </div>

    <!-- 左侧分类栏：贴住左边框的毛玻璃抽屉，收起 / 展开的把手长在玻璃侧面 -->
    <aside class="gal-rail" data-gal-rail aria-label={railLabel}>
      <div class="gal-rail__panel">
        <div class="gal-rail__list" id="gal-tags" data-gal-chips role="group" aria-label="按标签筛选照片">
          <button type="button" class="gal-tag" data-gal-tag="" aria-pressed="true">
            <span class="gal-tag__name">全部</span>
            <span class="gal-tag__n" data-gal-count>{photos.length}</span>
          </button>
          {
            tags.map((item) => (
              <button type="button" class="gal-tag" data-gal-tag={item.tag} aria-pressed="false">
                <span class="gal-tag__name">{item.tag}</span>
                <span class="gal-tag__n">{item.count}</span>
              </button>
            ))
          }
        </div>
      </div>

      <button
        type="button"
        class="gal-rail__handle"
        data-gal-rail-toggle
        aria-expanded="true"
        aria-controls="gal-tags"
        aria-label="收起分类"
        title="收起分类"
      >
        <span class="gal-rail__chev" aria-hidden="true"></span>
      </button>
    </aside>

    <!-- 右下角的竖向胶囊：上面那颗切「随机 / 顺序」，下面那颗「回到正中」。
         两颗共用一层毛玻璃（.gal-dock），脚本只认 data-gal-action，图标随排序状态切换。 -->
    <div class="gal-dock" data-gal-dock>
      <button
        type="button"
        class="gal-dock__btn"
        data-gal-action="order"
        aria-pressed="false"
        aria-label="随机排序"
        title="随机排序"
      >
        <Icon
          name="material-symbols:shuffle-rounded"
          class="gal-dock__ico gal-dock__ico--random h-4 w-4"
        />
        <Icon name="material-symbols:sort-rounded" class="gal-dock__ico gal-dock__ico--seq h-4 w-4" />
      </button>

      <button
        type="button"
        class="gal-dock__btn"
        data-gal-action="reset"
        aria-label="回到照片海正中"
        title="回到照片海正中"
      >
        <Icon name="material-symbols:center-focus-strong-outline" class="h-4 w-4" />
      </button>
    </div>

    <p class="gal-hint" data-gal-hint>按住左键拖动 · 点一下放大 · 再点看大图</p>
  </div>

  <!-- 撑出「一屏」的滚动距离：幕布本身就是滚动内容，这里只要额外给出一屏，
       页面就正好能滚过 banner 的高度，滚到尽头 = 照片海整屏 -->
  <div class="gal-spacer" data-gal-spacer aria-hidden="true"></div>

  <!-- 灯箱（第二次点击进入） -->
  <div class="gal-lb" data-gal-lb hidden aria-label="照片大图" role="dialog" aria-modal="true">
    <div class="gal-lb__canvas" data-gal-lb-canvas>
      <img class="gal-lb__img" data-gal-lb-img alt="" draggable="false" />
      <button type="button" class="gal-lb__btn gal-lb__close" data-gal-lb-close aria-label="关闭">
        <Icon name="material-symbols:close-rounded" class="h-4 w-4" />
      </button>
    </div>

    <div class="gal-lb__foot">
      <p class="gal-lb__cap" data-gal-lb-cap></p>

      <div class="gal-lb__tools">
        <span class="gal-lb__count" data-gal-lb-count></span>
        <button type="button" class="gal-lb__btn" data-gal-lb-zout aria-label="缩小">
          <Icon name="material-symbols:zoom-out-rounded" class="h-4 w-4" />
        </button>
        <button type="button" class="gal-lb__btn" data-gal-lb-fit aria-label="恢复原始大小">
          <Icon name="material-symbols:fit-screen-outline" class="h-4 w-4" />
        </button>
        <button type="button" class="gal-lb__btn" data-gal-lb-zin aria-label="放大">
          <Icon name="material-symbols:zoom-in-rounded" class="h-4 w-4" />
        </button>
        <button type="button" class="gal-lb__btn" data-gal-lb-prev aria-label="上一张">
          <Icon name="material-symbols:chevron-left-rounded" class="h-4 w-4" />
        </button>
        <button type="button" class="gal-lb__btn" data-gal-lb-next aria-label="下一张">
          <Icon name="material-symbols:chevron-right-rounded" class="h-4 w-4" />
        </button>
      </div>
    </div>
  </div>

  <noscript>
    <style>
      /* 没有 JS：退化成普通三列瀑布（照片按原比例排，能看能滚） */
      html.gal-page .layout--bleed { padding: 0 1rem 2rem !important; }
      html.gal-page .gal { position: static; }
      html.gal-page .gal-curtain,
      html.gal-page .gal-stars,
      html.gal-page .gal-hint,
      html.gal-page .gal-dock,
      html.gal-page .gal-dim,
      html.gal-page .gal-glow,
      html.gal-page .gal-spacer,
      html.gal-page .gal-rail { display: none !important; }
      html.gal-page .gal-view { position: static !important; height: auto !important; overflow: visible; }
      html.gal-page .gal-stage {
        position: static !important;
        transform: none !important;
        column-count: 3;
        column-gap: var(--gal-gap);
      }
      html.gal-page .gal-cell {
        position: static !important;
        display: block;
        width: 100% !important;
        height: auto !important;
        margin: 0 0 var(--gal-gap);
        opacity: 1 !important;
        transform: none !important;
        break-inside: avoid;
      }
      html.gal-page .gal-cell img { height: auto; }
      @media (max-width: 768px) {
        html.gal-page .gal-stage { column-count: 2; }
      }
    </style>
  </noscript>

  <script>
    import '../scripts/gallery-wall';
  </script>
</BaseLayout>
