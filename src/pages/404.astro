---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
---

<BaseLayout title="页面不存在" description="你要找的页面不存在" indexable={false} noindex sidebar={false}>
  <div class="card-neu card-neu--flat flex flex-col items-center gap-3 px-6 py-20 text-center">
    <p class="text-6xl font-bold leading-none text-primary/25">404</p>
    <h1 class="text-lg font-bold">这个页面不在了</h1>
    <p class="max-w-md text-sm text-base-content/50">
      可能链接写错了，或者文章被我改名了。也可能它从来就不存在。
    </p>
    <div class="mt-2 flex flex-wrap items-center justify-center gap-2">
      <a href="/" class="btn-pill text-sm">
        <Icon name="material-symbols:home-outline" class="h-4 w-4" />
        回到首页
      </a>
      <a href="/archive/" class="btn-pill text-sm">
        <Icon name="material-symbols:calendar-month-outline" class="h-4 w-4" />
        文章归档
      </a>
      <a href="/search/" class="btn-pill text-sm">
        <Icon name="material-symbols:search-rounded" class="h-4 w-4" />
        搜一下
      </a>
    </div>
  </div>
</BaseLayout>
