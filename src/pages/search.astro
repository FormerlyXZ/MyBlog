---
/**
 * 全文搜索页（Pagefind）
 * ------------------------------------------------------------
 * 索引在 npm run build 时自动生成（astro build && pagefind --site dist），
 * 纯静态、不需要后端，搜标题和正文都行。
 *
 * 支持从侧栏搜索框带参数进来：/search/?q=关键词 会自动填入并搜索。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/widgets/PageHeader.astro';
import Sidebar from '../components/sidebar/Sidebar.astro';
import { PAGE_TEXTS } from '../site.config';

const text = PAGE_TEXTS.search ?? { title: '搜索' };
---

<BaseLayout title={text.title} description="在站内所有文章中搜索" indexable={false} noindex pageId="search">
  <Fragment slot="sidebar">
    <Sidebar />
  </Fragment>

  <PageHeader
    title={text.title}
    subtitle="输入关键词，在标题和正文里查找；按 / 可以快速聚焦输入框"
  />

  <div class="card-neu card-neu--flat p-5">
    <div id="search" class="search-box"></div>
  </div>

  <script>
    import { onPageLoad } from '../scripts/pageload';

    const base = '/pagefind/';

    /** 只在第一次需要时往 <head> 里插样式与脚本 */
    function ensureAssets(): Promise<void> {
      return new Promise((resolve) => {
        if (!document.querySelector(`link[href="${base}pagefind-ui.css"]`)) {
          const link = document.createElement('link');
          link.rel = 'stylesheet';
          link.href = `${base}pagefind-ui.css`;
          document.head.appendChild(link);
        }

        if ((window as any).PagefindUI) {
          resolve();
          return;
        }

        let script = document.querySelector<HTMLScriptElement>(`script[src="${base}pagefind-ui.js"]`);
        if (!script) {
          script = document.createElement('script');
          script.src = `${base}pagefind-ui.js`;
          document.head.appendChild(script);
        }
        script.addEventListener('load', () => resolve(), { once: true });
        script.addEventListener('error', () => resolve(), { once: true });
      });
    }

    async function initSearch(): Promise<void> {
      const searchEl = document.getElementById('search');
      if (!searchEl) return;
      // ClientRouter 换页后 DOM 是新的，用 dataset 标记避免同一个容器重复初始化
      if (searchEl.dataset.init === '1') return;

      await ensureAssets();

      const PagefindUI = (window as any).PagefindUI;
      if (!PagefindUI) return;

      searchEl.dataset.init = '1';

      new PagefindUI({
        element: '#search',
        showSubResults: false,
        showImages: false,
        resetStyles: false,
        translations: {
          placeholder: '搜索文章…',
          clear_search: '清除',
          load_more: '加载更多结果',
          search_label: '搜索本站',
          filters_label: '筛选',
          zero_results: '没有找到和 [SEARCH_TERM] 相关的内容',
          many_results: '找到 [COUNT] 条和 [SEARCH_TERM] 相关的结果',
          one_result: '找到 1 条和 [SEARCH_TERM] 相关的结果',
          alt_search: '没有找到和 [SEARCH_TERM] 相关的内容，改为显示 [DIFFERENT_TERM] 的结果',
          search_suggestion: '没有找到和 [SEARCH_TERM] 相关的内容，试试下面这些：',
          searching: '正在搜索 [SEARCH_TERM]…',
        },
      });

      // 从 /search/?q=xxx 进来时自动搜一次
      const query = new URLSearchParams(location.search).get('q');
      const input = searchEl.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
      if (query && input) {
        input.value = query;
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.focus();
      }
    }

    // 按 / 快速聚焦搜索框（全局只绑一次；正在输入时不抢焦点）
    let shortcutBound = false;
    function bindShortcut(): void {
      if (shortcutBound) return;
      shortcutBound = true;
      document.addEventListener('keydown', (event) => {
        const target = event.target as HTMLElement | null;
        const typing =
          target &&
          (target.tagName === 'INPUT' ||
            target.tagName === 'TEXTAREA' ||
            target.isContentEditable);
        if (event.key !== '/' || typing) return;
        const input = document.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
        if (!input) return;
        event.preventDefault();
        input.focus();
      });
    }

    onPageLoad(() => {
      void initSearch();
      bindShortcut();
    });
  </script>
</BaseLayout>
