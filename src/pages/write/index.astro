---
/**
 * 在线写作页（取代原来的 Sveltia CMS）
 * ============================================================
 * · 未授权：只显示一个「用 GitHub 授权」空壳，什么都不拉取
 * · 已授权：显示表单，保存 = 一次 commit 写到 src/content/posts/<slug>.md
 * · /write/?slug=hello-world 会读回这篇文章并回填
 *
 * 令牌（repo 权限）只存在本机 localStorage['melodyxz-edit']，退出即清。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/widgets/PageHeader.astro';
import { Icon } from 'astro-icon/components';
import { REPO } from '../../consts';
import { BLOG_PAGE_SIZE } from '../../site.config';

const slugParam = Astro.url.searchParams.get('slug') ?? '';
---

<BaseLayout title="写文章" description="站长专用" noindex indexable={false} sidebar={false}>
  <PageHeader title="写文章" subtitle={`提交到 ${REPO.owner}/${REPO.name}，推送后自动部署`}>
    <div class="flex items-center gap-2">
      <a href="/" class="btn-pill text-xs">回到首页</a>
      <button type="button" class="btn-pill text-xs" data-edit-logout hidden>
        <Icon name="material-symbols:logout-rounded" class="h-4 w-4" />
        <span>退出写作授权</span>
      </button>
    </div>
  </PageHeader>

  <div data-write-root data-slug={slugParam}>
    <!--
      注意：这里是构建期读到的 query（纯静态站构建时永远为空），
      真正的 slug 由 write.ts 在浏览器里从 location.search 读取，data-slug 只作兜底。
    -->
    <!-- 未授权 -->
    <div class="card-neu card-neu--flat flex flex-col items-center gap-3 px-6 py-14 text-center" data-write-gate>
      <Icon name="ri:github-line" class="h-10 w-10 text-base-content/25" />
      <p class="text-sm font-medium">需要 GitHub 授权才能写文章</p>
      <p class="max-w-md text-xs leading-relaxed text-base-content/45">
        授权范围是 <code>repo</code>（只有你自己的浏览器保存这份令牌，退出即清除）。
        访客打开这个页面只会看到这个提示，看不到任何文章数据。
      </p>
      <button type="button" class="btn-pill mt-1 text-sm" data-edit-login>
        <Icon name="ri:github-line" class="h-4 w-4" />
        用 GitHub 授权
      </button>
    </div>

    <!-- 已授权：表单 -->
    <div class="hidden flex-col gap-4" data-write-form>
      <!-- 上传 .md：既能把现成文章读进表单，也能一次批量提交 -->
      <div class="card-neu card-neu--flat p-5" data-md-drop>
        <div class="flex flex-wrap items-center gap-3">
          <span class="flex items-center gap-2 text-sm font-bold">
            <Icon name="material-symbols:upload-file-rounded" class="h-4 w-4" />
            导入 .md 文件
          </span>
          <button type="button" class="btn-pill px-3 py-1.5 text-xs" data-md-pick>
            <Icon name="material-symbols:folder-open-outline" class="h-4 w-4" />
            <span>选择文件</span>
          </button>
          <input
            type="file"
            accept=".md,.markdown,.mdx,.txt,text/markdown,text/plain"
            multiple
            hidden
            data-md-input
          />
          <span class="text-xs leading-relaxed text-base-content/45">
            也可以直接拖进来 · 选 1 个：内容填进下面的表单，检查后点「保存并发布」·
            选多个：按文件名一次性批量提交
          </span>
        </div>
        <p class="mt-2 text-[0.6875rem] leading-relaxed text-base-content/40" data-md-status></p>
      </div>

      <div class="card-neu card-neu--flat p-5">
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="flex flex-col gap-1.5 sm:col-span-2">
            <span class="text-xs font-medium text-base-content/60">标题</span>
            <input class="input-pill" data-field="title" placeholder="文章标题" />
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-xs font-medium text-base-content/60">文件名（网址用它）</span>
            <input class="input-pill" data-field="slug" placeholder="hello-world" />
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-xs font-medium text-base-content/60">日期</span>
            <input class="input-pill" type="date" data-field="date" />
          </label>

          <label class="flex flex-col gap-1.5 sm:col-span-2">
            <span class="text-xs font-medium text-base-content/60">更新时间（可空）</span>
            <input class="input-pill" type="date" data-field="updated" />
            <span class="text-[0.6875rem] leading-relaxed text-base-content/40">
              留空时：编辑旧文章并保存会自动记为今天，文章页显示「更新于」；新文章留空则不显示。
            </span>
          </label>

          <label class="flex flex-col gap-1.5 sm:col-span-2">
            <span class="text-xs font-medium text-base-content/60">摘要（列表和 SEO 用）</span>
            <textarea class="input-pill min-h-16 rounded-neu" data-field="description" placeholder="一句话说明这篇文章讲什么"></textarea>
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-xs font-medium text-base-content/60">分类（逗号分隔）</span>
            <input class="input-pill" data-field="categories" placeholder="技术, 生活" />
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-xs font-medium text-base-content/60">标签（逗号分隔）</span>
            <input class="input-pill" data-field="tags" placeholder="Astro, 教程" />
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-xs font-medium text-base-content/60">封面图路径（可空）</span>
            <input class="input-pill" data-field="image" placeholder="/images/cover-1.svg" />
          </label>

          <label class="flex flex-col justify-end gap-1.5">
            <span class="text-xs font-medium text-base-content/60">上传封面（存到 public/images/）</span>
            <input
              type="file"
              accept="image/*"
              class="block w-full text-xs text-base-content/60 file:mr-3 file:rounded-full file:border-0 file:bg-primary/10 file:px-3 file:py-1.5 file:text-xs file:text-primary"
              data-cover-input
            />
          </label>

          <div class="flex flex-wrap items-center gap-4 sm:col-span-2">
            <label class="flex items-center gap-2 text-xs text-base-content/60">
              <input type="checkbox" class="toggle toggle-primary toggle-xs" data-field="badge" />
              置顶（badge: Pin）
            </label>
            <label class="flex items-center gap-2 text-xs text-base-content/60">
              <input type="checkbox" class="toggle toggle-primary toggle-xs" data-field="draft" />
              存为草稿（不显示在站点上）
            </label>
            <label class="flex items-center gap-2 text-xs text-base-content/60">
              <span>附件路径（每行一个）</span>
              <input class="input-pill w-48" data-field="attachments" placeholder="/files/a.pdf" />
            </label>
          </div>
        </div>
      </div>

      <div class="card-neu card-neu--flat p-5">
        <label class="flex flex-col gap-1.5">
          <span class="text-xs font-medium text-base-content/60">正文（Markdown）</span>
          <textarea
            class="input-pill min-h-[24rem] rounded-neu font-mono text-xs leading-relaxed"
            data-field="body"
            placeholder="## 小标题&#10;&#10;正文写在这里…"></textarea>
        </label>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <button type="button" class="btn-pill text-sm" data-write-preview>
          <Icon name="material-symbols:visibility-outline" class="h-4 w-4" />
          预览
        </button>
        <button type="button" class="btn-pill btn-pill--active text-sm" data-write-save>
          <Icon name="material-symbols:save-outline" class="h-4 w-4" />
          保存并发布
        </button>
        <button type="button" class="btn-pill text-sm" data-write-clear>
          <Icon name="material-symbols:add-circle-outline" class="h-4 w-4" />
          新建一篇
        </button>
        <p class="text-xs text-base-content/40" data-write-status></p>
      </div>

      <p class="rounded-neu bg-base-200/60 p-3 text-[0.6875rem] leading-relaxed text-base-content/45">
        提交后需要等自动部署完成（约 1 分钟）才能在线上看到。
        每页文章数当前为 {BLOG_PAGE_SIZE}，在 <code>config/site.json</code> 的 <code>blog.pageSize</code> 修改。
      </p>
    </div>
  </div>

  <!-- 预览弹窗：点「预览」后按保存后的样子渲染当前表单内容 -->
  <dialog
    class="max-h-[92dvh] w-[min(94vw,56rem)] rounded-card border-0 bg-base-100 p-0 text-base-content shadow-2xl backdrop:bg-black/70"
    data-preview-dialog
    aria-label="文章预览"
  >
    <div class="flex max-h-[92dvh] flex-col">
      <header class="flex flex-wrap items-center gap-2 border-b border-base-content/10 px-4 py-3 sm:px-5">
        <span class="flex items-center gap-2 text-sm font-bold">
          <Icon name="material-symbols:visibility-outline" class="h-4 w-4" />
          文章预览
        </span>
        <span class="text-xs text-base-content/45" data-preview-hint>保存前确认排版与 Markdown 语法</span>
        <div class="ml-auto flex items-center gap-2">
          <button type="button" class="btn-pill px-3 py-1.5 text-xs" data-preview-refresh>
            <Icon name="material-symbols:refresh" class="h-3.5 w-3.5" />
            <span>重新渲染</span>
          </button>
          <button type="button" class="btn-pill px-3 py-1.5 text-xs" data-preview-close>关闭</button>
        </div>
      </header>

      <div class="min-h-0 flex-1 overflow-y-auto px-4 py-4 sm:px-6">
        <!-- 封面 / 标题（和文章页头部的样子一致；没有封面图就用主题渐变兜底） -->
        <div class="relative overflow-hidden rounded-card shadow-neu-out">
          <div class="flex aspect-[21/9] w-full items-center justify-center bg-gradient-to-br from-primary/25 via-base-200 to-secondary/25">
            <span class="text-5xl font-bold text-primary/25" data-preview-first-char></span>
          </div>
          <img alt="" class="absolute inset-0 aspect-[21/9] w-full object-cover" decoding="async" hidden data-preview-cover-img />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/75 via-black/25 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-3 sm:p-4">
            <h1
              class="mx-auto max-w-3xl rounded-2xl border border-white/15 bg-black/35 px-4 py-2 text-center text-base font-bold leading-snug text-white backdrop-blur-md sm:text-xl"
              data-preview-title></h1>
          </div>
        </div>

        <!-- meta 行 -->
        <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs text-base-content/55" data-preview-meta></div>

        <!-- 正文 -->
        <article class="prose-blog card-neu card-neu--flat mt-4 p-4 sm:p-6" data-preview-body></article>
        <p class="hidden text-sm text-base-content/45" data-preview-empty>正文还是空的，先在下面写点内容吧。</p>
      </div>
    </div>
  </dialog>

  <script>
    import '../../scripts/write';
  </script>
</BaseLayout>
