                      <option value="sql">SQL</option>
                      <option value="markdown">Markdown</option>
                    </select>
                    <button
                      type="button"
                      class="wx-tool"
                      data-wx-tool="codeblock"
                      data-tip="围栏代码块 ```"
                    >
                      代码块
                    </button>
                  </div>
                  <button
                    type="button"
                    class="wx-tool wx-tool--table"
                    data-wx-tool="table"
                    data-tip="插入表格（先选几列 × 几行）"
                  >
                    <Icon name="material-symbols:data-table-outline-rounded" class="h-3.5 w-3.5" />
                    表格
                  </button>
                </div>
              </section>

              <section class="wx-toolgroup">
                <p class="wx-toolgroup__title">插入</p>
                <div class="wx-tools">
                  <button type="button" class="wx-tool" data-wx-tool="image" data-tip="从图床选图片插入">
                    <Icon name="material-symbols:image-outline-rounded" class="h-3.5 w-3.5" />
                    图片
                  </button>
                  <button type="button" class="wx-tool" data-wx-tool="attach" data-tip="从图床选附件插入">
                    <Icon name="material-symbols:attach-file-rounded" class="h-3.5 w-3.5" />
                    附件
                  </button>
                  <button type="button" class="wx-tool" data-wx-tool="date" data-tip="插入今天日期">
                    <Icon name="material-symbols:today-rounded" class="h-3.5 w-3.5" />
                    日期
                  </button>
                </div>
              </section>
            </div>

            <div data-wx-panel="outline" hidden>
              <div class="wx-outline" data-wx-outline></div>
              <div class="wx-outline-empty" data-wx-outline-empty hidden>正文里还没有标题</div>
            </div>
          </div>
        </aside>
      </div>

      <div class="wx-dropveil" data-wx-drop hidden>
        <Icon name="material-symbols:upload-file-rounded" class="h-7 w-7" />
        <span>松开上传到正文</span>
