            <Icon name="material-symbols:settings-outline-rounded" class="h-4 w-4" />
          </button>

          <button
            type="button"
            class="wx-btn wx-btn--primary wx-save"
            data-wx-save
            data-tip="保存并提交到 GitHub（Ctrl+S）"
            aria-label="保存并提交"
          >
            <Icon name="material-symbols:save-rounded" class="h-4 w-4" />
            <span>保存</span>
          </button>

          <button
            type="button"
            class="wx-iconbtn"
            data-wx-toggle-right
            data-tip="收起 / 展开快捷操作"
            aria-label="收起或展开快捷操作"
          >
