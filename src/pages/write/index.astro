            <button type="button" data-wx-mode="split" data-tip="编辑区 + 实时预览">分屏</button>
            <button type="button" data-wx-mode="preview" data-tip="只看最终渲染效果">预览</button>
          </div>

          <button
            type="button"
            class="wx-iconbtn"
            data-wx-settings
            data-tip="文章信息 / 标题 / 日期 / 分类"
            aria-label="文章信息"
