            <Icon name="material-symbols:close-rounded" class="h-4 w-4" />
          </button>
        </header>

        <div class="wx-dialog__body">
          <div class="wx-field">
            <span class="wx-field__label">
              文章结构
              <span class="wx-q" data-tip="单篇 = 一个文件；系列 = 多章共享目录页和章节导航">?</span>
            </span>
            <div class="wx-seg wx-seg--left">
              <label class="wx-radio">
                <input type="radio" name="wx-dmode" value="single" checked />
                <span>单篇</span>
              </label>
              <label class="wx-radio">
                <input type="radio" name="wx-dmode" value="series" />
                <span>系列章节</span>
              </label>
            </div>
          </div>

          <label class="wx-field">
            <span class="wx-field__label">标题</span>
            <input
              class="wx-input"
              data-wx-d-title
              placeholder="文章标题"
              autocomplete="off"
            />
          </label>

          <div class="wx-grid2">
            <label class="wx-field">
              <span class="wx-field__label">
                文件名
                <span class="wx-q" data-tip="决定文章网址 /posts/文件名/，通常自动生成">?</span>
              </span>
              <input
                class="wx-input"
                data-wx-d-slug
                placeholder="hello-world"
                autocomplete="off"
              />
            </label>
            <label class="wx-field">
              <span class="wx-field__label">
                日期
                <span class="wx-q" data-tip="列表排序用；新建文章默认今天">?</span>
              </span>
              <input class="wx-input" type="date" data-wx-d-date />
            </label>
          </div>

          <label class="wx-field">
            <span class="wx-field__label">
              摘要
              <span class="wx-q" data-tip="显示在列表卡片和搜索引擎结果里">?</span>
            </span>
            <textarea
              class="wx-textarea2"
              data-wx-d-description
              rows="2"
              placeholder="一句话说明这篇文章讲什么"></textarea>
          </label>

          <div class="wx-grid2">
            <label class="wx-field">
              <span class="wx-field__label">
                分类
                <span class="wx-q" data-tip="逗号分隔，例如：技术, 生活">?</span>
              </span>
              <input class="wx-input" data-wx-d-categories placeholder="技术, 生活" />
            </label>
            <label class="wx-field">
              <span class="wx-field__label">
                标签
                <span class="wx-q" data-tip="逗号分隔，例如：Astro, 教程">?</span>
              </span>
              <input class="wx-input" data-wx-d-tags placeholder="Astro, 教程" />
            </label>
          </div>

          <div class="wx-field">
            <span class="wx-field__label">
              封面
              <span class="wx-q" data-tip="建议 16:9，从图床 covers/ 里选一张">?</span>
            </span>
            <div class="wx-cover">
              <img class="wx-cover__thumb" data-wx-d-cover-thumb alt="" hidden />
              <input
                class="wx-input"
                data-wx-d-image
                placeholder="https://picture.melodyxz.top/covers/…"
              />
              <button type="button" class="wx-mini" data-wx-d-cover-pick>图床</button>
              <button type="button" class="wx-mini" data-wx-d-cover-clear>清除</button>
            </div>
          </div>

          <div class="wx-options">
            <label class="wx-toggle">
              <input type="checkbox" data-wx-d-badge />
              置顶
            </label>
            <label class="wx-toggle">
              <input type="checkbox" data-wx-d-draft />
              存为草稿
            </label>
          </div>

          <details class="wx-advanced" data-wx-details>
            <summary>更多设置</summary>
            <div class="wx-advanced__body">
              <div class="wx-seriesfields" data-wx-d-series-fields hidden>
                <label class="wx-field">
                  <span class="wx-field__label">
                    加入系列
                    <span class="wx-q" data-tip="选择已有系列，或新建一个">?</span>
                  </span>
                  <select class="wx-input" data-wx-d-series-select></select>
                </label>
                <div class="wx-grid3">
                  <label class="wx-field">
                    <span class="wx-field__label">
                      系列标识
                      <span class="wx-q" data-tip="英文目录名，例如 stm32">?</span>
                    </span>
                    <input class="wx-input" data-wx-d-series placeholder="stm32" />
                  </label>
                  <label class="wx-field">
                    <span class="wx-field__label">
                      本章序号
                      <span class="wx-q" data-tip="从 1 开始；目录页写 0">?</span>
                    </span>
                    <input
                      class="wx-input"
                      type="number"
                      min="0"
                      step="1"
                      data-wx-d-order
                      placeholder="1"
                    />
                  </label>
                  <label class="wx-field">
                    <span class="wx-field__label">
                      系列标题
                      <span class="wx-q" data-tip="首次建系列时用来生成目录页">?</span>
                    </span>
                    <input
                      class="wx-input"
                      data-wx-d-series-title
                      placeholder="STM32 单片机学习笔记"
                    />
                  </label>
                </div>
              </div>

              <div class="wx-grid2">
                <label class="wx-field">
                  <span class="wx-field__label">
                    更新时间
                    <span class="wx-q" data-tip="留空时，编辑旧文章保存会自动记为今天">?</span>
                  </span>
                  <input class="wx-input" type="date" data-wx-d-updated />
                </label>
                <label class="wx-field">
                  <span class="wx-field__label">
                    附件
                    <span class="wx-q" data-tip="每行一个 /files/ 路径">?</span>
                  </span>
                  <textarea
                    class="wx-textarea2"
                    data-wx-d-attachments
                    rows="2"
                    placeholder="/files/a.pdf"></textarea>
                </label>
              </div>
            </div>
          </details>
        </div>

        <footer class="wx-dialog__foot">
          <button type="button" class="wx-btn wx-btn--danger" data-wx-d-danger hidden>
            删除文章
          </button>
          <span class="wx-dialog__spacer"></span>
          <button type="button" class="wx-btn" data-wx-dialog-close>取消</button>
          <button type="submit" class="wx-btn wx-btn--primary" data-wx-dialog-submit>
            进入编辑
          </button>
        </footer>
      </form>
    </dialog>

    <input
      type="file"
      accept=".md,.markdown,.mdx,.txt,text/markdown,text/plain"
      multiple
      hidden
      data-wx-import-input
    />
  </div>

  <MediaDialog />

  <script type="application/json" id="write-manifest" is:inline set:html={manifestJson}></script>
  <script>
    import '../../scripts/write/app';
  </script>
</BaseLayout>
