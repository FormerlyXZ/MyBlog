              <Icon name="material-symbols:upload-file-rounded" class="h-4 w-4" />
            </button>
            <button
              type="button"
              class="wx-iconbtn"
              data-wx-sync
              data-tip="从仓库同步文章清单"
              aria-label="从仓库同步"
            >
              <Icon name="material-symbols:sync-rounded" class="h-4 w-4" />
            </button>
            <a
              class="wx-iconbtn"
              href="/media/"
              target="_blank"
              rel="noopener"
              data-tip="打开图床管理页"
              aria-label="打开图床管理页"
