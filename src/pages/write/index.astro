        </aside>

        <!-- ==================== 中：编辑器 ==================== -->
        <section class="wx-main">
          <div class="wx-empty" data-wx-empty>
            <span class="wx-empty__mark">
              <Icon name="material-symbols:auto-stories-rounded" class="h-8 w-8" />
            </span>
            <p class="wx-empty__title">选择一篇文章，或新建一篇</p>
            <div class="wx-empty__actions">
              <button type="button" class="wx-btn wx-btn--primary" data-wx-new>
                <Icon name="material-symbols:note-add-rounded" class="h-4 w-4" />
                新建文章
              </button>
              <button type="button" class="wx-btn" data-wx-import>
                <Icon name="material-symbols:upload-file-rounded" class="h-4 w-4" />
                导入 .md
              </button>
            </div>
          </div>

          <div class="wx-editor" data-wx-editor hidden>
            <div class="wx-dochead">
              <div class="wx-dochead__row">
                <input
                  class="wx-title"
                  data-wx-title
                  placeholder="未命名文章"
                  aria-label="文章标题"
                  autocomplete="off"
                />
                <button
                  type="button"
                  class="wx-iconbtn"
                  data-wx-settings
                  data-tip="文章信息 / 分类 / 标签 / 封面"
                  aria-label="文章信息"
                >
                  <Icon name="material-symbols:settings-outline-rounded" class="h-4 w-4" />
                </button>
              </div>

              <div class="wx-metabar">
                <span class="wx-chip" data-wx-chip-date></span>
                <span class="wx-chip" data-wx-chip-status></span>
                <span class="wx-chip wx-chip--pin" data-wx-chip-pin hidden>置顶</span>
                <span class="wx-chip wx-chip--series" data-wx-chip-series hidden></span>
                <span class="wx-chip" data-wx-chip-updated hidden></span>
                <span class="wx-metabar__cats" data-wx-chip-categories></span>
                <span class="wx-metabar__spacer"></span>
              </div>

              <div class="wx-recovery" data-wx-recovery hidden>
                <Icon name="material-symbols:history-rounded" class="h-4 w-4" />
                <span>发现 <b data-wx-recovery-time></b> 的本地草稿</span>
                <button type="button" class="wx-mini" data-wx-recover>恢复</button>
                <button type="button" class="wx-mini" data-wx-discard>忽略</button>
              </div>
            </div>

            <div class="wx-panes" data-wx-panes data-mode="edit">
              <div class="wx-pane wx-pane--edit">
                <div class="wx-gutter" data-wx-gutter aria-hidden="true"></div>
                <textarea
                  class="wx-textarea"
                  data-wx-body
                  spellcheck="false"
                  placeholder="从这里开始写 Markdown…"></textarea>
              </div>
              <div class="wx-pane wx-pane--preview">
                <article class="prose-blog wx-preview" data-wx-preview></article>
              </div>
            </div>

            <div class="wx-statusbar">
              <span data-wx-words>0 字</span>
              <span data-wx-reading></span>
              <span data-wx-cursor></span>
              <span class="wx-statusbar__warn" data-wx-warnings hidden></span>
              <span class="wx-statusbar__spacer"></span>
              <span data-wx-last></span>
            </div>
          </div>
        </section>

        <!-- ==================== 右：智能操作 ==================== -->
        <aside class="wx-right" aria-label="智能快捷操作">
          <div class="wx-right__head">
            <div class="wx-tabs" role="tablist" aria-label="右侧栏">
              <button type="button" class="wx-tab is-active" data-wx-tab="tools" role="tab">
                快捷操作
              </button>
              <button type="button" class="wx-tab" data-wx-tab="outline" role="tab">大纲</button>
            </div>
            <span class="wx-right__spacer"></span>
            <button
              type="button"
              class="wx-help"
              data-tip="快捷键：Ctrl+S 保存 · Ctrl+B 加粗 · Ctrl+I 斜体 · Ctrl+K 链接 · Tab 缩进 · Enter 继续列表"
              aria-label="快捷键说明"
            >
              ?
            </button>
          </div>

          <div class="wx-right__body">
            <div data-wx-panel="tools">
              <section class="wx-toolgroup">
                <p class="wx-toolgroup__title">标题</p>
                <div class="wx-tools wx-tools--6">
                  <button type="button" class="wx-tool" data-wx-tool="heading" data-level="1" data-tip="# 一级标题">
                    H1
                  </button>
                  <button type="button" class="wx-tool" data-wx-tool="heading" data-level="2" data-tip="## 二级标题">
                    H2
                  </button>
                  <button type="button" class="wx-tool" data-wx-tool="heading" data-level="3" data-tip="### 三级标题">
                    H3
                  </button>
                  <button type="button" class="wx-tool" data-wx-tool="heading" data-level="4" data-tip="#### 四级标题">
                    H4
                  </button>
                  <button type="button" class="wx-tool" data-wx-tool="heading" data-level="5" data-tip="##### 五级标题">
                    H5
                  </button>
                  <button type="button" class="wx-tool" data-wx-tool="heading" data-level="6" data-tip="###### 六级标题">
                    H6
                  </button>
                </div>
              </section>

              <section class="wx-toolgroup">
                <p class="wx-toolgroup__title">文本</p>
                <div class="wx-tools">
                  <button type="button" class="wx-tool wx-tool--bold" data-wx-tool="bold" data-tip="加粗 **文字**（Ctrl+B）">
                    B
                  </button>
                  <button type="button" class="wx-tool wx-tool--italic" data-wx-tool="italic" data-tip="斜体 *文字*（Ctrl+I）">
                    I
                  </button>
                  <button type="button" class="wx-tool" data-wx-tool="strike" data-tip="删除线 ~~文字~~">
                    <s>S</s>
                  </button>
                  <button type="button" class="wx-tool wx-tool--mono" data-wx-tool="incline" data-tip="行内代码 `code`">
                    &lt;/&gt;
                  </button>
                  <button type="button" class="wx-tool" data-wx-tool="link" data-tip="链接 [文字](url)（Ctrl+K）">
                    链接
                  </button>
                  <button type="button" class="wx-tool" data-wx-tool="footnote" data-tip="脚注 [^1]">
                    脚注
                  </button>
                </div>
              </section>

              <section class="wx-toolgroup">
                <p class="wx-toolgroup__title">列表与块</p>
                <div class="wx-tools">
                  <button type="button" class="wx-tool" data-wx-tool="ul" data-tip="无序列表 - 项目">
                    • 列表
                  </button>
