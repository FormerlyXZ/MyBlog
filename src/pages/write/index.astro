---
/**
 * 写作台（/write）
 * ============================================================
 * 把原来「一张长表单」重做成桌面写作应用式的三栏工作区：
 *
 *   顶部    保留全站 Banner / 导航
 *   窗口    一整块大卡片（类似桌面应用的窗口）
 *   左栏    所有文章：搜索 / 筛选 / 新建 / 批量管理 / 导入 / 同步
 *   中栏    标题 + 元信息 + Markdown 编辑 / 分屏 / 预览
 *   右栏    智能快捷操作（全部 Markdown 语法）+ 文档大纲
 *
 * 数据约定（DOM 契约见 src/scripts/write/app.ts）：
 *   data-write-root / data-write-gate / data-wx-app
 *   所有 data-wx-* 属性和脚本一一对应，改样式随便改，属性名别动。
 *
 * 构建期清单（#write-manifest）只放「已发布文章」的元信息，不含草稿正文，
 * 访客查看 HTML 也拿不到隐藏内容；站长授权后会自动从 GitHub 同步完整清单。
 * ============================================================
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaDialog from '../../components/media/MediaDialog.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { wordCount } from '../../utils/posts';
import { REPO } from '../../consts';

const slugParam = Astro.url.searchParams.get('slug') ?? '';

const isoDay = (value: Date): string => value.toISOString().slice(0, 10);

/** 构建期文章清单（只含已发布；草稿由登录后的仓库同步补齐） */
const posts = await getCollection('posts', ({ data }) => data.draft !== true);

const manifest = posts
  .map((post) => {
    // Astro 的 glob loader 会把 <系列>/index.md 的 id 记成 "<系列>"，
    // 但写作台读写文件时要用真实路径（stm32/index.md），所以从 filePath 反推。
    const rawPath = (post.filePath ?? '').replace(/\\/g, '/');
    const path = rawPath.startsWith('src/content/posts/')
      ? rawPath
      : `src/content/posts/${post.id}.md`;
    const id = path.replace(/^src\/content\/posts\//, '').replace(/\.md$/i, '');

    return {
      id,
      path,
      title: post.data.title,
      date: isoDay(post.data.date),
      updated: post.data.updated ? isoDay(post.data.updated) : '',
      description: post.data.description ?? '',
      categories: post.data.categories,
      tags: post.data.tags,
      image: post.data.image ?? '',
      badge: post.data.badge ?? '',
      draft: false,
      series: post.data.series ?? '',
      seriesTitle: post.data.seriesTitle ?? '',
      seriesOrder: post.data.seriesOrder ?? null,
      words: wordCount(post.body),
    };
  })
  .sort((a, b) => (b.updated || b.date).localeCompare(a.updated || a.date));

const manifestJson = JSON.stringify(manifest).replace(/</g, '\\u003c');
---

<BaseLayout title="写作台" description="站长专用" noindex indexable={false} sidebar={false}>
  <div class="wx-root" data-write-root data-slug={slugParam}>
    <!-- ==================== 未授权 ==================== -->
    <section class="wx-gate" data-write-gate>
      <div class="wx-gate__card">
        <span class="wx-gate__mark">
