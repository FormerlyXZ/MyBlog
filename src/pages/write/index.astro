            <Icon name="material-symbols:left-panel-close-rounded" class="h-4 w-4" />
          </button>
          <span class="wx-appmark">
            <Icon name="material-symbols:edit-note-rounded" class="h-4 w-4" />
          </span>
          <span class="wx-appname">写作台</span>
          <span class="wx-breadcrumb">
            <span class="wx-breadcrumb__sep">/</span>
            <span data-wx-breadcrumb>写作台</span>
          </span>
        </div>

        <div class="wx-topbar__center">
          <span class="wx-savedot" data-wx-save-dot data-state="idle" aria-hidden="true"></span>
          <span class="wx-savetext" data-wx-save-state></span>
        </div>

        <div class="wx-topbar__right">
          <div class="wx-seg" role="group" aria-label="视图模式">
            <button type="button" data-wx-mode="edit" class="is-active" data-tip="只显示编辑区（Ctrl+S 保存）">
              编辑
