---
/**
 * 站点配置页（可视化编辑）
 * ============================================================
 * 2026-11 版重做：从「标题条 + 保存条 + 分类胶囊 + 一堆白卡」的四层割裂，
 * 改成主流设置页的范式 —— 左侧分类栏 + 右侧一整块内容 + 右上角保存。
 *
 *   布局   左侧 200px 分类栏（分 4 组），右侧单列内容，最大 880px
 *   内容   所有分组都在**一个**容器里，分组之间只有一条 hairline，不再切卡
 *   表单   两种行：label 左 180px / 控件右（单行），或 label 上 / 控件下（多行）
 *   保存   标题行右上，滚动时吸顶；改动未保存会亮一个橙点
 *
 * 说明文字（改版前 2963 字）的去处：
 *   · 字段级说明 → 本文件里的 JSX 注释 + docs/config-fields.md 字典
 *   · 板块级说明 → 同上，标题本身已经说清
 *   · 实操指引（导航图标怎么填、歌词什么格式）→ 折叠成「使用说明」，默认收起
 *
 * 权限：与 /write 同一份写作令牌；访客只看到授权空壳。
 *
 * ⚠ DOM 契约（src/scripts/config.ts、nav-admin.ts、music-admin.ts 依赖）：
 *   data-config-root / data-config-gate / data-config-form
 *   data-config-tab / data-config-panel        ← 侧栏切换
 *   data-config-save / -reload / -status / -format / -validate / -text
 *   data-nav-* / data-ma-* / data-cfg-*
 *   这些属性名一个都不能改，改样式随便改结构。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConfigSection from '../../components/config/ConfigSection.astro';
import ConfigField from '../../components/config/ConfigField.astro';
import ConfigImage from '../../components/config/ConfigImage.astro';
import MediaDialog from '../../components/media/MediaDialog.astro';
import { Icon } from 'astro-icon/components';
import { SITE_CONFIG } from '../../site.config';
import { THEME_LIST } from '../../utils/theme';

const CONFIG_PATH = 'config/site.json';
const { site, user, pages } = SITE_CONFIG;
const homeText = pages.home ?? { title: '', subtitle: '', typewriter: [] };

/** 左侧分类栏：分 4 组，避免 8 个平铺项没有层级 */
const NAV_GROUPS = [
  {
    title: '基本',
    items: [
      { id: 'site', label: '站点信息', icon: 'material-symbols:badge-outline', file: 'config/site.json' },
      { id: 'user', label: '个人资料', icon: 'material-symbols:person-outline', file: 'config/site.json' },
    ],
  },
  {
    title: '外观',
    items: [
      { id: 'banner', label: '横幅 Banner', icon: 'material-symbols:photo-size-select-large', file: 'config/site.json' },
      { id: 'home', label: '首页文案', icon: 'material-symbols:edit-note-rounded', file: 'config/site.json' },
      { id: 'theme', label: '主题外观', icon: 'material-symbols:palette-outline', file: 'config/site.json' },
    ],
  },
  {
    title: '内容',
    items: [
      { id: 'music', label: '音乐库', icon: 'material-symbols:queue-music-rounded', file: 'config/music.json' },
      { id: 'nav', label: '网站导航', icon: 'material-symbols:apps-rounded', file: 'config/navigation.json' },
    ],
  },
  {
    title: '高级',
    items: [
      { id: 'json', label: 'JSON 源码', icon: 'material-symbols:code-rounded', file: 'config/site.json' },
    ],
  },
];

const themeOptions = THEME_LIST.map((item) => ({
  value: item.name,
  label: `${item.name}${item.dark ? '（深色）' : ''}`,
}));

const bannerModeOptions = [
  { value: 'default', label: '默认（顶部横幅）' },
  { value: 'fullscreen', label: '全屏' },
  { value: 'background', label: '作为页面背景' },
  { value: 'hidden', label: '隐藏 Banner' },
];

const fitOptions = [
  { value: 'adapt', label: '跟着图片比例（不裁切）' },
  { value: 'cover', label: '固定高度（按 cover 裁切）' },
];
---

<BaseLayout title="站点配置" description="站长专用" noindex indexable={false} sidebar={false}>
  <div data-config-root data-config-path={CONFIG_PATH}>
    <!-- 未授权 -->
    <div class="cfg-gate" data-config-gate>
      <Icon name="material-symbols:settings-outline" class="h-9 w-9 text-base-content/25" />
      <p class="text-sm font-medium">需要 GitHub 授权才能改配置</p>
      <p class="cfg-gate__text">
        配置里有站名、头像、签名、菜单、横幅、页脚等全部站点信息，只有站长能改。
      </p>
      <button type="button" class="btn-pill btn-pill--active mt-1" data-edit-login>
        <Icon name="ri:github-line" class="h-4 w-4" />
        用 GitHub 授权
      </button>
    </div>

    <!-- 已授权 -->
    <div class="hidden" data-config-form>
      <div class="cfg-shell">
        <!-- ==================== 左侧分类栏 ==================== -->
        <aside class="cfg-side" aria-label="配置分类">
          {
            NAV_GROUPS.map((group) => (
              <div class="cfg-side__group">
                <p class="cfg-side__title">{group.title}</p>
                {group.items.map((item) => (
                  <button
                    type="button"
                    class:list={['cfg-side__item', item.id === 'site' && 'is-active']}
                    data-config-tab={item.id}
                    data-panel-file={item.file}
                    role="tab"
                    aria-selected={item.id === 'site' ? 'true' : 'false'}
                  >
                    <Icon name={item.icon} />
                    <span>{item.label}</span>
                  </button>
                ))}
              </div>
            ))
          }

          <div class="cfg-side__group">
            <button type="button" class="cfg-side__item" data-edit-logout hidden>
              <Icon name="material-symbols:logout-rounded" />
              <span>退出授权</span>
            </button>
            <a class="cfg-side__item" href="/">
              <Icon name="material-symbols:home-outline" />
              <span>回首页</span>
            </a>
          </div>
        </aside>

        <!-- ==================== 右侧内容 ==================== -->
        <div class="cfg-main">
          <!-- 顶部保存栏（吸顶） -->
          <div class="cfg-topbar">
            <div class="cfg-topbar__head">
              <h2 class="cfg-topbar__title" data-config-panel-title>站点信息</h2>
              <p class="cfg-topbar__file" data-config-panel-file>config/site.json</p>
            </div>

            <div class="cfg-topbar__actions">
              <span class="cfg-status" data-config-status></span>
              <button type="button" class="btn-pill" data-config-reload>
                <Icon name="material-symbols:refresh-rounded" class="h-4 w-4" />
                <span>重新读取</span>
              </button>
              <button type="button" class="btn-pill btn-pill--active" data-config-save>
                <Icon name="material-symbols:save-outline" class="h-4 w-4" />
                <span>保存并提交</span>
              </button>
            </div>
          </div>

          <div class="cfg-body">
            <!-- ============ ① 站点信息 ============ -->
            <div class="cfg-panel" data-config-panel="site">
              <ConfigSection title="站点名称">
                {/* 顶部导航的品牌名（标题栏用文字模式时显示它）；也会进个人卡、页脚、分享卡片 */}
                <ConfigField
                  path="site.title"
                  label="网站名"
                  value={site.title}
                  placeholder="MelodyZzX's Blog"
                />
                {/* 浏览器标签页上的标题 */}
                <ConfigField
                  path="site.tab"
                  label="标签页标题"
                  value={site.tab}
                  placeholder="MelodyZzX's Blog"
                />
                {/* SEO 描述，同时用作分享卡片的摘要 */}
                <ConfigField
                  path="site.description"
                  label="站点简介"
                  type="textarea"
                  rows={2}
                  wide
                  value={site.description}
                  placeholder="一句话说清这个站点写什么"
                />
                {/* BCP 47 语言代码，进 <html lang> */}
                <ConfigField path="site.language" label="语言代码" value={site.language} placeholder="zh-CN" />
                {/* date-fns 语法 */}
                <ConfigField
                  path="site.dateFormat"
                  label="日期格式"
                  value={site.dateFormat}
                  placeholder="yyyy-MM-dd"
                />
              </ConfigSection>

              <ConfigSection title="标题栏（顶部导航）">
                {/* 文字站名 或 图片 logo */}
                <ConfigField
                  path="site.titleType"
                  label="显示形式"
                  type="select"
                  value={site.titleType}
                  options={[
                    { value: 'image', label: '图片 logo' },
                    { value: 'text', label: '文字站名' },
                  ]}
                />
                {/* 透明底 PNG/SVG，高度 100px 往上更清晰 */}
                <ConfigImage
                  path="site.titleImage"
                  label="Logo 图片"
                  value={site.titleImage}
                  dir="public/brand"
                  shape="wide"
                />
                {/* 浏览器标签上的小图标，SVG 或 32×32 PNG */}
                <ConfigImage
                  path="site.favicon"
                  label="站点图标"
                  value={site.favicon}
                  dir="public"
                  shape="square"
                />
              </ConfigSection>
            </div>

            <!-- ============ ② 个人资料 ============ -->
            <div class="cfg-panel" data-config-panel="user" hidden>
              <ConfigSection title="头像与签名">
                {/*
                  换头像 = 全站一起换（侧栏个人卡、About 页、动态卡片、页脚署名）。
                  建议正方形 640×640 以上；提交后约 1 分钟生效，
                  如果还是旧头像就硬刷新（Ctrl / ⌘ + Shift + R）。
                */}
                <ConfigImage path="user.avatar" label="头像" value={user.avatar} dir="public" shape="square" />
                {/* About 页的大字、动态卡片昵称、页脚署名、文章许可说明都用它 */}
                <ConfigField path="user.name" label="昵称" value={user.name} placeholder="FormerlyXZ" />
                {/* 个人卡上那行渐变彩字 */}
                <ConfigField
                  path="user.description"
                  label="签名"
                  type="textarea"
                  rows={2}
                  wide
                  value={user.description}
                  placeholder="Ciallo～(∠・ω<)⌒★"
                />
                <ConfigField
                  path="user.site"
                  label="个人主页"
                  value={user.site}
                  placeholder="https://www.melodyxz.top"
                />
              </ConfigSection>

              <ConfigSection title="社交媒体">
                <div class="cfg-row cfg-row--block">
                  <span class="cfg-row__label">图标链接</span>
                  <div class="cfg-row__ctrl">
                    <div class="config-banner-list" data-cfg-social></div>
                    <div class="mt-3 flex flex-wrap items-center gap-2">
                      <button type="button" class="btn-pill" data-social-add>
                        <Icon name="material-symbols:add-circle-outline" class="h-4 w-4" />
                        <span>新增一个</span>
                      </button>
                      {/* 图标名用 Iconify：ri:github-line、ri:bilibili-line、ri:youtube-line … */}
                      <span class="text-[0.6875rem] text-base-content/35">Iconify 图标名</span>
                    </div>
                  </div>
                </div>
              </ConfigSection>
            </div>

            <!-- ============ ③ 横幅 Banner ============ -->
            <div class="cfg-panel" data-config-panel="banner" hidden>
              <ConfigSection title="横幅图片">
                <div class="cfg-row cfg-row--block">
                  <span class="cfg-row__label">轮播图片</span>
                  <div class="cfg-row__ctrl">
                    <div class="config-banner-list" data-cfg-banner-images></div>

                    <div class="mt-3 flex flex-wrap items-center gap-2">
                      <button type="button" class="btn-pill" data-banner-upload>
                        <Icon name="material-symbols:upload-rounded" class="h-4 w-4" />
                        <span>上传图片</span>
                      </button>
                      <button type="button" class="btn-pill" data-banner-library>
                        <Icon name="material-symbols:perm-media-outline" class="h-4 w-4" />
                        <span>从图床选</span>
                      </button>
                      <input type="file" accept="image/*" multiple hidden data-banner-upload-input />
                      {/* 也可以直接填路径：/banner/xxx.jpg */}
                      <input class="input-pill w-52" data-banner-new-path placeholder="/banner/xxx.jpg" />
                      <button type="button" class="btn-pill" data-banner-add-path>添加</button>
                    </div>
                    {/* 压缩后存图床 covers/，不进仓库；建议横图 16:9 或更宽，单张 300KB 以内 */}
                  </div>
                </div>
              </ConfigSection>

              <ConfigSection title="文字大小">
                {/* 乘在响应式字号上：调小后手机和桌面一起按比例缩，窄屏不会溢出 */}
                <ConfigField
                  path="site.banner.titleScale"
                  label="大标题字号"
                  type="range"
                  value={site.banner.titleScale}
                  min={0.4}
                  max={1.4}
                  step={0.05}
                  unit="倍"
                  wide
                />
                {/* 竖屏还会被「最长那句一行放得下」的上限再压一次 */}
                <ConfigField
                  path="site.banner.subtitleScale"
                  label="打字机字号"
                  type="range"
                  value={site.banner.subtitleScale}
                  min={0.4}
                  max={1.4}
                  step={0.05}
                  unit="倍"
                  wide
                />
              </ConfigSection>

              <ConfigSection title="轮播与显示">
                {/* 8000 = 每 8 秒换一张；建议 3000–15000 */}
                <ConfigField
                  path="site.banner.interval"
                  label="循环时间"
                  type="number"
                  unit="毫秒"
                  min={1000}
                  step={500}
                  value={site.banner.interval}
                  placeholder="8000"
                />
                <ConfigField
                  path="site.banner.fit"
                  label="高度适配"
                  type="select"
                  value={site.banner.fit}
                  options={fitOptions}
                />
                {/* 仅「跟着图片比例」时生效 */}
                <ConfigField path="site.banner.ratio" label="宽高比" value={site.banner.ratio} placeholder="16 / 9" />
                {/* 仅「固定高度」时生效 */}
                <ConfigField path="site.banner.height" label="固定高度" value={site.banner.height} placeholder="70vh" />
                {/* 越大文字越清楚、图片越暗 */}
                <ConfigField
                  path="site.banner.overlay"
                  label="黑色遮罩"
                  type="number"
                  unit="0 – 1"
                  min={0}
                  max={1}
                  step={0.05}
                  value={site.banner.overlay}
                  placeholder="0.4"
                />
              </ConfigSection>
            </div>

            <!-- ============ ④ 首页文案 ============ -->
            <div class="cfg-panel" data-config-panel="home" hidden>
              <ConfigSection title="首页 Banner 文案">
                <ConfigField
                  path="pages.home.title"
                  label="大标题"
                  value={homeText.title}
                  placeholder="MelodyZzX's Blog"
                />
                {/* 打字机列表为空时显示这一句 */}
                <ConfigField
                  path="pages.home.subtitle"
                  label="副标题"
                  value={homeText.subtitle}
                  placeholder="记录技术、生活与思考"
                />
                {/* 一行一句，逐字打出并循环；留空则只显示副标题 */}
                <ConfigField
                  path="pages.home.typewriter"
                  label="打字机标语"
                  type="lines"
                  rows={6}
                  wide
                  value={homeText.typewriter ?? []}
                  placeholder="一行一句"
                />
              </ConfigSection>
            </div>

            <!-- ============ ⑤ 音乐库（config/music.json） ============ -->
            <div class="cfg-panel" data-config-panel="music" hidden>
              <div class="cfg-group" data-music-admin>
                <div class="cfg-toolbar">
                  <button type="button" class="btn-pill" data-ma-add-playlist>
                    <Icon name="material-symbols:playlist-add-rounded" class="h-4 w-4" />
                    <span>新建歌单</span>
                  </button>
                  <button type="button" class="btn-pill btn-pill--active" data-ma-save>
                    <Icon name="material-symbols:save-outline" class="h-4 w-4" />
                    <span>保存并提交</span>
                  </button>
                  <button type="button" class="btn-pill" data-ma-reload>
                    <Icon name="material-symbols:refresh-rounded" class="h-4 w-4" />
                    <span>重新读取</span>
                  </button>
                  <button type="button" class="btn-pill" data-ma-migrate>
                    <Icon name="material-symbols:move-to-inbox-outline" class="h-4 w-4" />
                    <span>搬进图床</span>
                  </button>
                  <span class="cfg-toolbar__status ma-status" data-ma-status></span>
                </div>

                <details class="cfg-notes">
                  <summary class="cfg-notes__summary">使用说明</summary>
                  <div class="cfg-notes__body">
                    <p>
                      音频和封面都存在图床（<code>picture.melodyxz.top</code> 的 <code>music/</code> 分类），
                      仓库里只留 <code>config/music.json</code>。歌词支持带时间轴的 <code>.lrc</code>，
                      贴文本或上传文件都行；纯文本也能用，只是不跟唱、只滚动。
                    </p>
                    <p>
                      「搬进图床」只对还留在仓库里的老文件有用：点一次会把它们全部搬到图床
                      （服务器之间搬，不占上行带宽），并删除仓库里的原件。搬过一次之后就没有东西可搬了。
                    </p>
                    <p>一次「保存并提交」= 一次 commit，部署完成后音乐页和左下角碟片会自动出现。</p>
                  </div>
                </details>

                <div class="flex flex-col" data-ma-playlists>
                  <div class="ma-empty">读取中…</div>
                </div>
              </div>
            </div>

            <!-- ============ ⑥ 网站导航（config/navigation.json） ============ -->
            <div class="cfg-panel" data-config-panel="nav" hidden>
              <div class="cfg-group" data-nav-admin>
                <div class="cfg-toolbar">
                  <button type="button" class="btn-pill" data-nav-add-group>
                    <Icon name="material-symbols:create-new-folder-outline" class="h-4 w-4" />
                    <span>新增分组</span>
                  </button>
                  <button type="button" class="btn-pill btn-pill--active" data-nav-save>
                    <Icon name="material-symbols:save-outline" class="h-4 w-4" />
                    <span>保存并提交</span>
                  </button>
                  <button type="button" class="btn-pill" data-nav-reload>
                    <Icon name="material-symbols:refresh-rounded" class="h-4 w-4" />
                    <span>重新读取</span>
                  </button>
                  <span class="cfg-toolbar__status na-status" data-nav-status></span>
                </div>

                <details class="cfg-notes">
                  <summary class="cfg-notes__summary">使用说明</summary>
                  <div class="cfg-notes__body">
                    <p>
                      数据结构是「分组 → 站点」，每个站点有名称、网址、一句介绍和图标，都写在
                      <code>config/navigation.json</code> 里。
                    </p>
                    <p>
                      图标可以填站内路径（如 <code>/nav/itdog.ico</code>）或外链，也可以点「上传图标」
                      传到 <code>public/nav/</code>；图片留空时会回落到「图标名」里的 Iconify 名
                      （如 <code>ri:github-line</code>）。
                    </p>
                    <p>一次「保存并提交」= 一次 commit，约 1 分钟后导航页生效。</p>
                  </div>
                </details>

                <div class="flex flex-col gap-4" data-nav-groups>
                  <p class="na-empty">读取中…</p>
                </div>

                <input type="file" accept="image/*" hidden data-nav-file />
              </div>
            </div>

            <!-- ============ ⑦ 主题外观 ============ -->
            <div class="cfg-panel" data-config-panel="theme" hidden>
              <ConfigSection title="默认配色">
                {/* 访客第一次打开站点时看到的主题 */}
                <ConfigField
                  path="site.theme.light"
                  label="浅色主题"
                  type="select"
                  value={site.theme.light}
                  options={themeOptions.filter((item) => !item.label.includes('深色'))}
                />
                <ConfigField
                  path="site.theme.dark"
                  label="深色主题"
                  type="select"
                  value={site.theme.dark}
                  options={themeOptions.filter((item) => item.label.includes('深色'))}
                />
                {/* 关掉后仅保留默认的明暗切换 */}
                <ConfigField
                  path="site.theme.allowSelector"
                  label="允许访客换配色"
                  type="toggle"
                  value={site.theme.allowSelector}
                />
                {/* 访客自己切过之后以他的选择为准 */}
                <ConfigField
                  path="site.theme.bannerMode"
                  label="Banner 显示方式"
                  type="select"
                  value={site.theme.bannerMode}
                  options={bannerModeOptions}
                />
              </ConfigSection>
            </div>

            <!-- ============ ⑧ JSON 源码 ============ -->
            <div class="cfg-panel" data-config-panel="json" hidden>
              <div class="cfg-group">
                <div class="cfg-toolbar">
                  <button type="button" class="btn-pill" data-config-format>
                    <Icon name="material-symbols:format-align-left-rounded" class="h-4 w-4" />
                    <span>格式化</span>
                  </button>
                  <button type="button" class="btn-pill" data-config-validate>
                    <Icon name="material-symbols:check-circle-outline" class="h-4 w-4" />
                    <span>校验格式</span>
                  </button>
                  {/* 菜单、页脚、评论这些不在可视化板块里的字段，直接在这里改 */}
                </div>

                <div class="cfg-row cfg-row--block">
                  <span class="cfg-row__label" title={CONFIG_PATH}>{CONFIG_PATH}</span>
                  <div class="cfg-row__ctrl">
                    <textarea
                      class="input-pill min-h-[26rem] font-mono text-xs"
                      data-config-text
                      spellcheck="false"></textarea>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 各处的「从图床选图」都用这个弹窗 -->
  <MediaDialog />

  <script>
    import '../../scripts/config';
    import '../../scripts/nav-admin';
    import '../../scripts/music-admin';
  </script>
