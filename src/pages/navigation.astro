---
/**
 * 导航页：南航相关的入口 + 常用工具站点
 * ------------------------------------------------------------
 * 数据来自 config/navigation.json：
 *   分组 category → 若干站点 { name, url, description, logo | icon }
 * 站长可以在 /config →「网站导航」里可视化增删改，保存即提交到仓库。
 *
 * 布局：一行两个卡片（手机一列），每张卡带站点自己的图标、
 * 一句介绍和域名；分类筛选 + 关键词过滤在前端完成（scripts/nav-filter.ts）。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/widgets/PageHeader.astro';
import Sidebar from '../components/sidebar/Sidebar.astro';
import EmptyState from '../components/widgets/EmptyState.astro';
import SiteCard from '../components/nav/SiteCard.astro';
import { Icon } from 'astro-icon/components';
import { LINK_GROUPS, linkCategories } from '../utils/links';
import { PAGE_TEXTS } from '../site.config';

const text = PAGE_TEXTS.navigation ?? { title: '网站导航' };
const categories = linkCategories();
const total = LINK_GROUPS.reduce((sum, group) => sum + group.items.length, 0);
---

<BaseLayout title={text.title} description={text.subtitle} pageId="navigation">
  <Fragment slot="sidebar">
    <Sidebar />
  </Fragment>

  <PageHeader title={text.title} subtitle={text.subtitle} meta={`${LINK_GROUPS.length} 个分类 · 共 ${total} 个`} />

  <div data-link-page>
    <!-- 筛选栏 -->
    <div class="card-neu card-neu--flat mb-5 flex flex-col gap-3 p-4 sm:flex-row sm:items-center">
      <div class="relative flex-1">
        <label class="sr-only" for="link-search">搜索导航</label>
        <input
          id="link-search"
          type="search"
          class="input-pill pr-9"
          placeholder="搜索名称、介绍或网址…"
          data-link-search
        />
        <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-base-content/35">
          <Icon name="material-symbols:search-rounded" class="h-4 w-4" />
        </span>
      </div>

      <div class="flex flex-wrap items-center gap-1.5">
        <button type="button" class="btn-pill text-xs" data-link-filter="全部" aria-pressed="true">
          全部
        </button>
        {
          categories.map((category) => (
            <button type="button" class="btn-pill text-xs" data-link-filter={category} aria-pressed="false">
              {category}
            </button>
          ))
        }
      </div>
    </div>

    <p class="mb-3 text-xs text-base-content/40">
      共 <span data-link-count>{total}</span> 个链接
    </p>

    <!-- 分组列表：一行三个站点卡 -->
    <div class="flex flex-col gap-6">
      {
        LINK_GROUPS.map((group) => (
          <section data-link-group>
            <h2 class="section-title">
              {group.icon && <Icon name={group.icon} class="h-4 w-4 text-primary" />}
              <span>{group.category}</span>
              <span class="text-xs font-normal tabular-nums text-base-content/35">{group.items.length}</span>
            </h2>
            <div class="grid gap-3 sm:grid-cols-2">
              {group.items.map((item) => (
                <SiteCard
                  name={item.name}
                  url={item.url}
                  category={group.category}
                  description={item.description}
                  logo={item.logo}
                  icon={item.icon}
                />
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <div data-link-empty hidden>
      <EmptyState
        title="没有匹配的链接"
        hint="换个关键词，或点「全部」看看。"
        icon="material-symbols:search-off-rounded"
      />
    </div>
  </div>

  <script>
    import '../scripts/nav-filter';
  </script>
</BaseLayout>
