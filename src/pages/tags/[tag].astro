---
/**
 * 单个标签下的文章列表
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/widgets/PageHeader.astro';
import Sidebar from '../../components/sidebar/Sidebar.astro';
import PostCard from '../../components/card/PostCard.astro';
import PostMetaScript from '../../components/card/PostMetaScript.astro';
import EmptyState from '../../components/widgets/EmptyState.astro';
import { getSortedPosts, getTags } from '../../utils/posts';

export const getStaticPaths: GetStaticPaths = async () => {
  const tags = await getTags();
  const posts = await getSortedPosts();

  return tags.map(({ tag }) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.includes(tag)),
    },
  }));
};

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`所有带有「${tag}」标签的文章`} pageId="tags">
  <Fragment slot="sidebar">
    <Sidebar />
  </Fragment>

  <PageHeader title={`#${tag}`} subtitle="标签归档" meta={`共 ${posts.length} 篇`}>
    <a href="/tags/" class="btn-pill text-xs">全部标签</a>
  </PageHeader>

  {
    posts.length === 0 ? (
      <EmptyState title="这个标签下还没有文章" />
    ) : (
      <div class="flex flex-col gap-4">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    )
  }

  <PostMetaScript />
</BaseLayout>
