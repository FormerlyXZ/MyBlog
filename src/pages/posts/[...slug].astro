---
/**
 * 文章正文页（路径保持 /posts/<slug>/ 不变，D6）
 * ============================================================
 * 结构：
 *   头部卡（封面 + 标题 + meta + 分类标签）
 *   移动端目录 → 正文卡 → 阅读进度胶囊 → 附件 → 版权分享 → 上下篇 → 评论
 *   右下角固定一颗「回到顶部」圆钮（滚过一段才露面）
 *   桌面目录与个人卡在左侧栏（粘性）
 *
 * 系列文章（多文件长文）额外处理：
 *   侧栏 = ①系列章节卡 ②当前章目录 ③个人卡
 *   上/下篇 = 系列内的上一章 / 下一章（而不是全站日期序）
 *   目录页 = 正文下方自动列出本系列全部章节
 *
 * 保留：data-pagefind-body（全文搜索）、SEO props、点赞/阅读数、附件、评论
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import TOC from '../../components/post/TOC.astro';
import PostHeader from '../../components/post/PostHeader.astro';
import ReadingBar from '../../components/post/ReadingBar.astro';
import Attachments from '../../components/post/Attachments.astro';
import License from '../../components/post/License.astro';
import PostNavigation from '../../components/post/PostNavigation.astro';
import BackToTop from '../../components/widgets/BackToTop.astro';
import SeriesToc from '../../components/series/SeriesToc.astro';
import SeriesChapters from '../../components/series/SeriesChapters.astro';
import ProfileBar from '../../components/sidebar/ProfileBar.astro';
import Giscus from '../../components/Giscus.astro';
import {
  effectiveTags,
  getListingPosts,
  postSlug,
  postUrl,
  isSeriesIndex,
  type Post,
} from '../../utils/posts';
import { getPostSeries, getSeriesPosition } from '../../utils/series';
import { formatDate } from '../../utils/date';
import { SITE, SITE_URL } from '../../site.config';
import type { NavLink } from '../../utils/navigation';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => data.draft !== true);
  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

/* ---- 系列（多文件长文） ---- */
const series = await getPostSeries(post);
const seriesIndexPage = isSeriesIndex(post);
const position = series ? getSeriesPosition(series, post) : null;
/** 当前页是系列里的某一章（导读页不算） */
const inSeriesChapter = Boolean(position && position.position > 0);

/**
 * 上一篇 / 下一篇：
 *   · 系列章节：系列内的上一章 / 下一章；第一章的“上一篇”补成导读，
 *     最后一章的“下一篇”补成时间线上更早的一篇文章。
 *   · 系列导读：左侧接上一篇普通文章，右侧直接“开始阅读”第一章。
 *   · 普通文章：按全站列表序；到了全站最早 / 最新一篇时，用归档页补位。
 *
 * 这样每篇文章底部始终有两块可点的跳转，不再出现“第一篇只剩右边、
 * 最后一篇只剩左边”的断头路。
 */
const navPost = (
  target: Post,
  label: string,
  kind: NavLink['kind'],
  meta?: string,
): NavLink => ({
  href: postUrl(target),
  title: target.data.title,
  label,
  kind,
  meta: meta ?? formatDate(target.data.date, SITE.dateFormat),
});

const archiveLink = (): NavLink => ({
  href: '/archive/',
  title: '全部文章归档',
  label: '文章归档',
  kind: 'archive',
  meta: '按时间浏览所有文章',
});

const listing = await getListingPosts();
const at = listing.findIndex((item) => item.id === post.id);
const olderSite = at >= 0 && at < listing.length - 1 ? listing[at + 1] : undefined;
const newerSite = at > 0 ? listing[at - 1] : undefined;

// 章节不在 getListingPosts() 里，所以“最后一章之后读什么”要看导读后面的那一篇。
const guideAt = series?.index
  ? listing.findIndex((item) => item.id === series.index?.id)
  : -1;
const olderAfterGuide =
  guideAt >= 0 && guideAt < listing.length - 1 ? listing[guideAt + 1] : undefined;

let olderLink: NavLink;
let newerLink: NavLink;

if (inSeriesChapter && series && position) {
  const guide = series.index;
  const total = series.chapters.length;
  const prev = position.prev;
  const next = position.next;

  olderLink = prev
    ? navPost(prev.post, '上一章', 'chapter', `第 ${prev.order} 章 · 共 ${total} 章`)
    : guide
      ? navPost(guide, '系列导读', 'guide', `共 ${total} 章`)
      : archiveLink();

  newerLink = next
    ? navPost(next.post, '下一章', 'chapter', `第 ${next.order} 章 · 共 ${total} 章`)
    : olderAfterGuide
      ? navPost(olderAfterGuide, '下一篇', 'post')
      : guide
        ? navPost(guide, '回到导读', 'guide', `共 ${total} 章`)
        : archiveLink();
} else if (series && seriesIndexPage) {
  const first = series.chapters[0];

  olderLink = olderSite ? navPost(olderSite, '上一篇', 'post') : archiveLink();
  newerLink = first
    ? navPost(first.post, '开始阅读', 'chapter', `第 1 章 · 共 ${series.chapters.length} 章`)
    : newerSite
      ? navPost(newerSite, '下一篇', 'post')
      : archiveLink();
} else {
  olderLink = olderSite ? navPost(olderSite, '上一篇', 'post') : archiveLink();
  newerLink = newerSite ? navPost(newerSite, '下一篇', 'post') : archiveLink();
}

const url = postUrl(post);
const absoluteUrl = new URL(url, SITE_URL).href;
const attachments = post.data.attachments;

// 后台「编辑本篇」用 post.id（普通文章 = 文件名，系列文章 = stm32/03-xxx）
const entry = post.id;

/**
 * 底部胶囊「复制全文」用的 Markdown 原文。
 * 直接内联在页面里（而不是再发一次请求）：点一下就能拿到，离线也可用。
 * 用 JSON + 转义 `<`，避免正文里出现 </script> 把标签提前闭合。
 */
const markdown = `# ${post.data.title}\n\n${post.body ?? ''}`.trim();
const markdownJson = JSON.stringify(markdown).replace(/</g, '\\u003c');
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedAt={post.data.date}
  updatedAt={post.data.updated}
  tags={effectiveTags(post)}
  typewriter
  pageId="home"
>
  <Fragment slot="sidebar">
    {
      series ? (
        <SeriesToc
          series={series}
          currentId={post.id}
          position={position?.position ?? 0}
          headings={headings}
        >
          <Fragment slot="footer"><ReadingBar url={absoluteUrl} /></Fragment>
        </SeriesToc>
      ) : (
        <TOC headings={headings} variant="sidebar" title={post.data.title}>
          <Fragment slot="footer"><ReadingBar url={absoluteUrl} /></Fragment>
        </TOC>
      )
    }
    <ProfileBar />
  </Fragment>

  <article>
    <!-- 系列面包屑：第 3 章 · STM32 单片机学习笔记 -->
    {
      series && (
        <nav class="mb-3 flex flex-wrap items-center gap-1.5 text-xs text-base-content/50" data-pagefind-ignore>
          <a href={series.url} class="inline-flex items-center gap-1 hover:text-primary">
            <Icon name="material-symbols:auto-stories-outline" class="h-3.5 w-3.5" />
            {series.title}
          </a>
          <span aria-hidden="true">/</span>
          <span class="text-base-content/70">
            {seriesIndexPage
              ? '系列导读'
              : `第 ${position?.position ?? 1} 章 · 共 ${position?.total ?? series.chapters.length} 章`}
          </span>
        </nav>
      )
    }

    <PostHeader post={post} url={url} entry={entry} />

    <!-- 移动端：系列目录（折叠）+ 普通目录（桌面用左侧栏那份） -->
    <div class="lg:hidden">
      {
        series ? (
          <SeriesToc
            series={series}
            currentId={post.id}
            position={position?.position ?? 0}
            headings={headings}
            variant="inline"
          >
            <Fragment slot="footer"><ReadingBar url={absoluteUrl} /></Fragment>
          </SeriesToc>
        ) : (
          <TOC headings={headings} variant="inline" title={post.data.title}>
            <Fragment slot="footer"><ReadingBar url={absoluteUrl} /></Fragment>
          </TOC>
        )
      }
    </div>

    <div class="card-neu card-neu--flat prose-blog p-5 sm:p-7">
      <Content />

      <!-- 系列目录页：自动列出全部章节（不用在 index.md 里手写目录） -->
      {series && seriesIndexPage && <SeriesChapters series={series} />}
    </div>

    <!-- 复制全文用的原文（不渲染、不参与搜索索引） -->
    <script is:inline type="application/json" id="post-md" data-pagefind-ignore set:html={markdownJson} />

    <Attachments files={attachments} />
    <License title={post.data.title} url={url} />
    <PostNavigation older={olderLink} newer={newerLink} />
    <Giscus />
  </article>

  <!-- 右下角「回到顶部」小圆钮：滚过一段才露面，点一下平滑回页首 -->
  <BackToTop />
</BaseLayout>

<script>
  // 正文里的长代码块自动折起来（超出一截就折，点「展开全部」再看）
  import '../../scripts/code-fold';
  // 代码块右上角挂复制按钮（成功时变成对勾）
  import '../../scripts/code-copy';
  // 正文图片点开看大图
  import '../../scripts/image-zoom';
  // 表格套上圆角外框，窄屏横向滚动时给出渐隐提示
  import '../../scripts/table-scroll';
</script>
