---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import ViewCounter from '../../components/ViewCounter.astro';
import LikeButton from '../../components/LikeButton.astro';
import Giscus from '../../components/Giscus.astro';
import AdminLink from '../../components/AdminLink.astro';
import { getSortedPosts, postUrl, readingTime } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => data.draft !== true);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// 上一篇 / 下一篇
const all = await getSortedPosts();
const index = all.findIndex((p) => p.id === post.id);
const newer = index > 0 ? all[index - 1] : undefined;
const older = index >= 0 && index < all.length - 1 ? all[index + 1] : undefined;

const minutes = readingTime(post.body);
const url = postUrl(post);
const attachments = post.data.attachments;

// 后台「编辑本篇」需要的是磁盘上的真实文件名（post.filePath），不是网址里的 post.id
const entry = (post.filePath ?? `${post.id}.md`).split('/').pop()!.replace(/\.md$/, '');

/** 附件文件名（去掉路径、URL 解码） */
function fileLabel(path: string): string {
  const name = path.split('/').pop() || path;
  try {
    return decodeURIComponent(name);
  } catch {
    return name;
  }
}

/** 按扩展名给附件配个小图标 */
function fileIcon(path: string): string {
  const name = path.split('/').pop()?.toLowerCase() ?? '';
  const ext = name.includes('.') ? name.split('.').pop() : '';
  switch (ext) {
    case 'pdf':
      return '📄';
    case 'zip':
    case 'rar':
    case '7z':
    case 'tar':
    case 'gz':
      return '🗜️';
    case 'doc':
    case 'docx':
      return '📝';
    case 'xls':
    case 'xlsx':
    case 'csv':
      return '📊';
    case 'ppt':
    case 'pptx':
      return '📽️';
    case 'mp3':
    case 'wav':
      return '🎵';
    case 'mp4':
    case 'webm':
      return '🎬';
    default:
      return '📎';
  }
}
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedAt={post.data.date}
  tags={post.data.tags}
>
  <article>
    <header class="post-header">
      <h1 class="post-title">{post.data.title}</h1>
      <div class="post-meta">
        <span>发布于 <FormattedDate date={post.data.date} /></span>
        <span>·</span>
        <span>约 {minutes} 分钟读完</span>
        <span>·</span>
        <ViewCounter path={url} />
        {
          post.data.tags.length > 0 && (
            <div class="post-meta__tags">
              {post.data.tags.map((tag) => (
                <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>
                  #{tag}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      attachments.length > 0 && (
        <section class="attachments" aria-label="附件下载">
          <h2>附件下载</h2>
          <ul class="attachments-list">
            {attachments.map((file) => (
              <li>
                <a href={file} target="_blank" rel="noopener">
                  <span class="attachment-icon" aria-hidden="true">
                    {fileIcon(file)}
                  </span>
                  {fileLabel(file)}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="post-actions-row">
      <LikeButton path={url} />
    </div>

    <nav
      style="margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid var(--border);display:flex;flex-wrap:wrap;gap:1rem;justify-content:space-between;font-size:.9375rem"
      aria-label="上下篇导航"
      data-pagefind-ignore
    >
      {
        older ? (
          <a href={postUrl(older)}>← {older.data.title}</a>
        ) : (
          <span />
        )
      }
      {
        newer ? (
          <a href={postUrl(newer)} style="text-align:right;margin-left:auto">
            {newer.data.title} →
          </a>
        ) : (
          <span />
        )
      }
    </nav>

    <div class="post-footer-row" data-pagefind-ignore>
      <a class="back-link" href="/posts/">← 返回文章列表</a>
      <AdminLink entry={entry} />
    </div>
  </article>

  <Giscus />
</BaseLayout>
