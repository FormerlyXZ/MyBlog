{
  "name": "myblog",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "一个纯静态的个人博客，基于 Astro 构建",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "sync:fonts": "node scripts/sync-fonts.mjs",
    "gen:assets": "node scripts/gen-placeholders.mjs",
    "gen:logo": "node scripts/prep-logo.mjs",
    "gen:banner": "node scripts/prep-banner.mjs",
    "deploy:worker": "wrangler deploy --config worker/wrangler.toml"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@iconify-json/lucide": "^1.2.146",
    "@iconify-json/material-symbols": "^1.2.95",
    "@iconify-json/ri": "^1.2.10",
    "astro": "^7.4.0",
    "astro-icon": "^1.2.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "@fontsource/zcool-kuaile": "^5.3.0",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.20",
    "daisyui": "^4.12.23",
    "pagefind": "^1.5.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
